contract SwapFactoryV2 {
  state {
    pools: list[address]
    pool_count: int
    // [V4-AUDIT-FIX] pools_by_pair maps token_a -> token_b -> pool_addr.
    // This supports multiple pools per token (e.g. WOCT/OES and WOCT/USDC), fixing
    // the critical routing limitation in v3.0 where pool_by_a restricted each token
    // to at most one pool globally.
    pools_by_pair: map[address]map[address]address
    pool_token_pair: map[address]address  // pool_addr -> token_a (metadata)
    pool_token_b_map: map[address]address // pool_addr -> token_b (metadata)
    fee_to: address
    fee_to_setter: address
    trusted_tokens: map[address]bool
    trusted_list: list[address]
    pending_setter: address
    paused: bool
    trusted_removed: map[address]bool
    // [SECURITY] Track position of each trusted token in the list for O(1) swap-pop on remove
    // Value is 0-based index in trusted_list; absent (default 0) means not in list
    // (collision with legitimate index 0 is avoided by storing position+1)
    trusted_position: map[address]int
    // [ARCH] Equilibrium price guard config (V4-hook-inspired, adapted for AML)
    hub_token: address
    price_tolerance_bps: int
  }

  event PoolCreated(token_a: address, token_b: address, pool: address, pool_id: int)
  // [SECURITY] H-4: PoolRemoved event for indexer awareness on update_pool
  event PoolRemoved(token_a: address, token_b: address, old_pool: address, new_pool: address)
  event TrustedTokenAdded(token: address)
  event TrustedTokenRemoved(token: address)
  event SetterTransferInitiated(current: address, pending: address)
  event SetterTransferred(old_setter: address, new_setter: address)
  event Paused(status: bool)
  // [SECURITY] Event for fee_to changes
  event FeeToChanged(old_fee_to: address, new_fee_to: address)
  // [ARCH] Equilibrium guard events
  event HubTokenSet(old_hub: address, new_hub: address)
  event PriceToleranceSet(old_bps: int, new_bps: int)

  constructor() {
    self.fee_to_setter = origin
    self.fee_to = origin
    self.pool_count = 0
    self.pending_setter = ""
    self.paused = false
    // [ARCH] Equilibrium guard defaults: no hub (disabled), 1% tolerance
    self.hub_token = ""
    self.price_tolerance_bps = 100
  }

  fn set_paused(status: bool): bool {
    require(caller == self.fee_to_setter, "not authorized")
    self.paused = status
    emit Paused(status)
    return true
  }

  // [V4-AUDIT-FIX] register_pool: Permissionless — anyone can deploy & register a pool.
  fn register_pool(token_a: address, token_b: address, pool: address): bool {
    require(!self.paused, "factory paused")
    require(token_a != token_b, "identical tokens")
    require(pool != "", "zero pool address")
    assert_address(token_a)
    assert_address(token_b)
    assert_address(pool)

    require(self.pool_token_pair[pool] == "" || self.pool_token_pair[pool] == "0", "pool already registered")

    // [AUDIT-FIX H-3] Verify the pool is a genuine initialized SwapPool for this
    // exact pair. Prevents an attacker from front-running a new pair registration
    // with an arbitrary/malicious address. View calls return the stored token; if
    // the pool is not a contract or holds different tokens, registration reverts.
    require(call(pool, "get_token_a", []) == token_a, "pool token_a mismatch")
    require(call(pool, "get_token_b", []) == token_b, "pool token_b mismatch")

    // Validate that no pool already exists for this specific token pair
    require(self.pools_by_pair[token_a][token_b] == "" || self.pools_by_pair[token_a][token_b] == "0", "pool already exists for this pair")
    require(self.pools_by_pair[token_b][token_a] == "" || self.pools_by_pair[token_b][token_a] == "0", "pool already exists for this pair")

    // Map the pool in both directions
    self.pools_by_pair[token_a][token_b] = pool
    self.pools_by_pair[token_b][token_a] = pool

    // Store both token_a and token_b for complete pool metadata
    self.pool_token_pair[pool] = token_a
    self.pool_token_b_map[pool] = token_b

    self.pools.push(pool)
    let pool_id = self.pool_count
    self.pool_count = pool_id + 1
    emit PoolCreated(token_a, token_b, pool, pool_id)
    return true
  }

  fn set_fee_to(_fee_to: address): bool {
    require(caller == self.fee_to_setter, "not authorized")
    assert_address(_fee_to)
    require(_fee_to != "", "zero address")
    let old_fee_to = self.fee_to
    self.fee_to = _fee_to
    // [SECURITY] Emit event for transparency
    emit FeeToChanged(old_fee_to, _fee_to)
    return true
  }

  fn initiate_setter_transfer(_setter: address): bool {
    require(caller == self.fee_to_setter, "not authorized")
    assert_address(_setter)
    require(_setter != "", "zero address")
    require(_setter != self.fee_to_setter, "same setter")
    self.pending_setter = _setter
    emit SetterTransferInitiated(self.fee_to_setter, _setter)
    return true
  }

  fn accept_setter_transfer(): bool {
    require(caller == self.pending_setter, "not pending setter")
    require(self.pending_setter != "", "no pending transfer")
    let old_setter = self.fee_to_setter
    self.fee_to_setter = self.pending_setter
    self.pending_setter = ""
    emit SetterTransferred(old_setter, self.fee_to_setter)
    return true
  }

  fn add_trusted_token(token: address): bool {
    require(caller == self.fee_to_setter, "not authorized")
    assert_address(token)
    // [SECURITY] H-3: Explicit zero-address check for clarity
    require(token != "", "zero token address")
    require(!self.trusted_tokens[token], "already trusted")
    self.trusted_tokens[token] = true
    self.trusted_removed[token] = false
    // [SECURITY] Only push to list if not already present (avoids duplicates)
    // trusted_position[token] == 0 means not in list (we store position+1)
    if self.trusted_position[token] == 0 {
      self.trusted_list.push(token)
      self.trusted_position[token] = len(self.trusted_list)
    }
    emit TrustedTokenAdded(token)
    return true
  }

  fn remove_trusted_token(token: address): bool {
    require(caller == self.fee_to_setter, "not authorized")
    assert_address(token)
    // [SECURITY] H-3: Explicit zero-address check for clarity
    require(token != "", "zero token address")
    require(self.trusted_tokens[token], "not trusted")
    self.trusted_tokens[token] = false
    self.trusted_removed[token] = true
    // [SECURITY] Remove from list using swap-pop to keep list consistent with is_trusted
    // The position is stored as (1-based) in trusted_position[token]
    let pos = self.trusted_position[token]
    if pos > 0 {
      // Convert to 0-based index
      let idx = pos - 1
      let last_idx = len(self.trusted_list) - 1
      if idx != last_idx {
        // Swap with last element
        let last_token = self.trusted_list[last_idx]
        self.trusted_list[idx] = last_token
        self.trusted_position[last_token] = idx + 1
      }
      // Pop the last element
      self.trusted_list.pop()
      self.trusted_position[token] = 0
    }
    emit TrustedTokenRemoved(token)
    return true
  }

  fn update_pool(token_a: address, token_b: address, pool: address): bool {
    require(!self.paused, "factory paused")
    require(caller == self.fee_to_setter, "not authorized")
    // [SECURITY] Full validation: zero addresses, identical tokens
    require(pool != "", "zero pool address")
    require(token_a != token_b, "identical tokens")
    assert_address(pool)
    assert_address(token_a)
    assert_address(token_b)
    require(self.pool_token_pair[pool] == "" || self.pool_token_pair[pool] == "0", "pool already registered")

    let old_pool = self.pools_by_pair[token_a][token_b]
    if old_pool == "" || old_pool == "0" {
      old_pool = self.pools_by_pair[token_b][token_a]
    }
    require(old_pool != "" && old_pool != "0", "no existing pool for pair")
    require(pool != old_pool, "pool unchanged")

    self.pools_by_pair[token_a][token_b] = pool
    self.pools_by_pair[token_b][token_a] = pool
    self.pool_token_pair[pool] = token_a
    self.pool_token_b_map[pool] = token_b
    // [SECURITY] Clear old pool metadata to avoid state inconsistency
    self.pool_token_pair[old_pool] = ""
    self.pool_token_b_map[old_pool] = ""
    // [SECURITY] M-3: Remove old pool from the `pools` list to avoid stale entries
    // in `all_pools()`. Iterate the list, find the old pool, swap-pop it.
    let i = 0
    let found = false
    while i < len(self.pools) {
      if self.pools[i] == old_pool {
        let last_idx = len(self.pools) - 1
        if i != last_idx {
          let last_pool = self.pools[last_idx]
          self.pools[i] = last_pool
        }
        self.pools.pop()
        found = true
      }
      i += 1
    }
    // Decrement pool_count since we removed one
    if found {
      self.pool_count = self.pool_count - 1
    }
    self.pools.push(pool)
    let pool_id = self.pool_count
    self.pool_count = pool_id + 1
    // [SECURITY] H-4: Emit PoolRemoved event for the old pool (so indexers can track
    // pool replacements) followed by PoolCreated for the new one.
    emit PoolRemoved(token_a, token_b, old_pool, pool)
    emit PoolCreated(token_a, token_b, pool, pool_id)
    return true
  }

  view fn get_pool(token_a: address, token_b: address): address {
    let pool = self.pools_by_pair[token_a][token_b]
    if pool != "" && pool != "0" {
      return pool
    }
    let pool2 = self.pools_by_pair[token_b][token_a]
    if pool2 != "" && pool2 != "0" {
      return pool2
    }
    return ""
  }

  view fn get_pool_token_a(pool: address): address {
    return self.pool_token_pair[pool]
  }

  view fn get_pool_token_b(pool: address): address {
    return self.pool_token_b_map[pool]
  }

  view fn all_pools(): list[address] {
    return self.pools
  }

  view fn pools_length(): int {
    return self.pool_count
  }

  view fn is_trusted(token: address): bool {
    return self.trusted_tokens[token]
  }

  // [V4-AUDIT-FIX] Simplified get_trusted_tokens to return the full list and avoid
  // local .push which is unsupported by the AML compiler. Filtering is handled off-chain.
  view fn get_trusted_tokens(): list[address] {
    return self.trusted_list
  }

  // [V4-AUDIT-FIX] Simplified trusted_tokens_count
  view fn trusted_tokens_count(): int {
    return len(self.trusted_list)
  }

  view fn get_fee_to(): address {
    return self.fee_to
  }

  view fn get_pending_setter(): address {
    return self.pending_setter
  }

  view fn get_fee_to_setter(): address {
    return self.fee_to_setter
  }

  // [ARCH] Equilibrium price guard — admin config

  fn set_hub_token(token: address): bool {
    require(caller == self.fee_to_setter, "not authorized")
    assert_address(token)
    let old = self.hub_token
    self.hub_token = token
    emit HubTokenSet(old, token)
    return true
  }

  fn set_price_tolerance_bps(bps: int): bool {
    require(caller == self.fee_to_setter, "not authorized")
    require(bps > 0 && bps <= 500, "tolerance must be 1-500 bps (0.01%-5%)")
    let old = self.price_tolerance_bps
    self.price_tolerance_bps = bps
    emit PriceToleranceSet(old, bps)
    return true
  }

  // [ARCH] validate_initial_price — called by SwapPool during first add_liquidity.
  // Derives the equilibrium price of token_a in token_b via the hub token path
  // (token_a → hub → token_b) using existing pools' get_price() (single-int return).
  // Returns true (allow) if: hub not configured, direct hub pair, no hub path,
  // or computation overflows int64 (extreme ratios). Only enforces when all math
  // fits safely — overflow-safe fallback prevents DoS.
  fn validate_initial_price(token_a: address, token_b: address, amount_a: int, amount_b: int): bool {
    let hub = self.hub_token
    if hub == "" || hub == "0" {
      return true
    }
    if token_a == hub || token_b == hub {
      return true
    }
    if amount_a <= 0 || amount_b <= 0 {
      return true
    }

    let pool_ah = self.pools_by_pair[token_a][hub]
    if pool_ah == "" || pool_ah == "0" {
      pool_ah = self.pools_by_pair[hub][token_a]
    }
    let pool_hb = self.pools_by_pair[hub][token_b]
    if pool_hb == "" || pool_hb == "0" {
      pool_hb = self.pools_by_pair[token_b][hub]
    }
    if pool_ah == "" || pool_ah == "0" || pool_hb == "" || pool_hb == "0" {
      return true
    }

    let ah_price = call(pool_ah, "get_price", [])
    let hb_price = call(pool_hb, "get_price", [])
    if ah_price <= 0 || hb_price <= 0 {
      return true
    }

    let ah_ta = call(pool_ah, "get_token_a", [])
    let hb_ta = call(pool_hb, "get_token_a", [])

    // price_a_in_hub: how much hub per 1 token_a, scaled by 10^6
    let price_a_in_hub = ah_price
    if ah_ta != token_a {
      if ah_price < 1000000 {
        return true
      }
      price_a_in_hub = 1000000000000 / ah_price
    }

    // price_hub_in_b: how much token_b per 1 hub, scaled by 10^6
    let price_hub_in_b = hb_price
    if hb_ta != hub {
      if hb_price < 1000000 {
        return true
      }
      price_hub_in_b = 1000000000000 / hb_price
    }

    // eq_price = price_a_in_hub * price_hub_in_b / 10^6 (scaled by 10^6)
    let prod = price_a_in_hub * price_hub_in_b
    if price_a_in_hub > 0 && prod / price_a_in_hub != price_hub_in_b {
      return true
    }
    let eq_price = prod / 1000000
    if eq_price <= 0 {
      return true
    }

    // user_price = amount_b * 10^6 / amount_a (scaled by 10^6)
    let amt_b_scaled = amount_b * 1000000
    if amount_b > 0 && amt_b_scaled / amount_b != 1000000 {
      return true
    }
    let user_price = amt_b_scaled / amount_a
    if user_price <= 0 {
      return true
    }

    // Tolerance: |user_price - eq_price| / eq_price <= tolerance_bps / 10000
    let diff = 0
    if user_price > eq_price {
      diff = user_price - eq_price
    } else {
      diff = eq_price - user_price
    }

    let lhs = diff * 10000
    if diff > 0 && lhs / diff != 10000 {
      return true
    }
    let rhs = eq_price * self.price_tolerance_bps
    if eq_price > 0 && rhs / eq_price != self.price_tolerance_bps {
      return true
    }

    require(lhs <= rhs, "initial price misaligned with equilibrium")
    return true
  }
}
