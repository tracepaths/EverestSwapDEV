contract SwapPool {
  state {
    token_a: address
    token_b: address
    reserve_a: int
    reserve_b: int
    total_lp: int
    factory: address
    fee_numerator: int
    fee_denominator: int
    active: bool
    owner: address
    locked: bool
    minimum_liquidity: int
    // [V2-AUDIT-FIX V2-MED-1] Track accumulated fees separately so divergence
    // between actual token balance and reserve_a/reserve_b is explicit and auditable.
    fee_reserve_a: int
    fee_reserve_b: int
    // [V2-AUDIT-FIX V2-LOW-2] Two-step ownership transfer: pending_owner must accept.
    pending_owner: address
    // [V7] Position-based LP tracking (UniswapV4-like)
    position_owners: map[int]address
    position_liquidities: map[int]int
    position_unlock_times: map[int]int
    position_owner_count: map[address]int
    next_position_id: int
    total_liquidity: int
    // [SECURITY] Indexed position linked list per user to avoid gas-bomb linear scans
    user_position_next: map[int]int   // position_id → next position_id of same owner (0 = end)
    user_position_prev: map[int]int   // position_id → prev position_id of same owner (0 = none)
    user_head_position: map[address]int  // first position_id for this user
    user_tail_position: map[address]int  // last position_id for this user
    // [SECURITY] Max positions per user to prevent DoS
    max_positions_per_user: int
    // [SECURITY] Incremental total locked LP for O(1) view
    total_locked_lp: int
    // [S1-SP-02] Max initial price ratio (e.g., 100 = max 100:1 or 1:100)
    max_initial_price_ratio: int
    // [SECURITY] TWAP oracle — cumulative price for manipulation-resistant pricing
    twap_price_cumulative_a: int
    twap_price_cumulative_b: int
    twap_last_update_epoch: int
  }

  event Swap(who: address, token_in: address, amount_in: int, amount_out: int)
  event AddLiquidity(who: address, amount_a: int, amount_b: int, lp: int)
  event RemoveLiquidity(who: address, amount_a: int, amount_b: int, lp: int)
  event PositionAdded(id: int, owner: address, liquidity: int, unlock_time: int)
  event PositionRemoved(id: int, owner: address, liquidity: int)
  event Sync(reserve_a: int, reserve_b: int)
  event PoolActivated(active: bool)
  // [SECURITY] Event for max positions per user updates
  event MaxPositionsPerUserUpdated(limit: int)
  // [SECURITY] M-8: Event for fee params updates
  event FeeParamsSet(old_num: int, old_denom: int, new_num: int, new_denom: int)
  // [V2-AUDIT-FIX V2-LOW-2] Two-step ownership events
  event OwnershipTransferProposed(current_owner: address, proposed_owner: address)
  event OwnershipTransferred(old_owner: address, new_owner: address)
  // [V3-AUDIT-FIX] Event for claimed fees
  event FeesClaimed(recipient: address, amount_a: int, amount_b: int)

  constructor() {
    self.token_a = origin
    self.token_b = origin
    self.reserve_a = 0
    self.reserve_b = 0
    self.total_lp = 0
    self.factory = origin
    self.fee_numerator = 3
    self.fee_denominator = 1000
    self.active = true
    self.owner = origin
    self.locked = false
    self.minimum_liquidity = 1000
    // [V2-AUDIT-FIX V2-MED-1] Initialise fee accumulators
    self.fee_reserve_a = 0
    self.fee_reserve_b = 0
    // [V2-AUDIT-FIX V2-LOW-2] No pending owner at construction
    self.pending_owner = ""
    // [V7] Initialize position tracking
    self.next_position_id = 1
    self.total_liquidity = 0
    // [SECURITY] Max 100 positions per user to prevent DoS
    self.max_positions_per_user = 100
    // [SECURITY] Incremental total locked LP tracking
    self.total_locked_lp = 0
    // [S1-SP-02] Default max initial price ratio: 100 (max 100:1 or 1:100)
    self.max_initial_price_ratio = 100
  }

  // [V2-AUDIT-FIX V2-LOW-1] set_tokens: guard against re-initialization by checking that
  // token_a and token_b still equal origin (their unset sentinel value).
  fn set_tokens(addr_a: address, addr_b: address): bool {
    require(caller == self.owner, "not authorized")
    require(self.total_lp == 0, "already initialized")
    assert_address(addr_a)
    assert_address(addr_b)
    require(addr_a != addr_b, "identical tokens")
    require(self.token_a == origin && self.token_b == origin, "tokens already set")
    self.token_a = addr_a
    self.token_b = addr_b
    return true
  }

  // [ARCH] set_factory: one-time binding to the SwapFactory address.
  // Enables the equilibrium price guard callback during first add_liquidity.
  fn set_factory(addr: address): bool {
    require(caller == self.owner, "not authorized")
    require(self.factory == origin, "factory already set")
    assert_address(addr)
    require(addr != "", "zero factory address")
    self.factory = addr
    return true
  }

  // [AUDIT-FIX HIGH-1, CRIT-2] Use sqrt for LP initial, burn minimum_liquidity
  // [V2-AUDIT-FIX V2-CRIT-1] CEI: all state updates happen BEFORE external calls
  // [V2-AUDIT-FIX V2-CRIT-2] Use revert() on min_lp failure so TX rolls back atomically
  // [SECURITY] H-1: All calculations and validations are done BEFORE any external call,
  // so if the user-provided amounts or min_lp result in a revert, the user's tokens
  // have not yet been pulled.
  // [V11] Factory-first: add_liquidity_for lets the pool owner (the deploying
  // factory) mint the initial LP position directly to a recipient. Tokens are
  // always pulled from the caller (the factory must hold both amounts first).
  // Direct callers may only credit themselves (recipient == caller).
  fn add_liquidity_for(recipient: address, amount_a: int, amount_b: int, min_lp: int, deadline: int, lock_duration: int): (int, int, int) {
    require(recipient == caller || caller == self.owner, "not authorized")
    assert_address(recipient)
    // [AUDIT-FIX MED-1] Deadline check - enforce 5-minute max
    require(deadline > epoch && deadline <= epoch + 300, "deadline must be 1-300 seconds from now")
    require(self.active, "pool not active")
    require(!self.locked, "reentrancy guard")
    require(amount_a > 0 && amount_b > 0, "zero amounts")
    require(self.token_a != "" && self.token_b != "", "tokens not set")
    // [V7-HIGH-5] Validate lock_duration cannot be negative
    require(lock_duration >= 0, "lock_duration cannot be negative")
    // [SECURITY] H-2: Cap max lock_duration to prevent epoch overflow on unlock_epoch
    // 365 days = 365 * 24 * 60 = 525,600 minutes
    require(lock_duration <= 525600, "lock_duration too long (max 365 days)")
    // [SECURITY] Per-user position cap to prevent DoS
    require(self.position_owner_count[recipient] < self.max_positions_per_user, "max positions reached")

    self.locked = true

    let is_first = self.total_lp == 0

    if is_first {
      // [V8-SECURITY] Only the pool owner can seed initial liquidity. Without
      // this guard, anyone could front-run the first add_liquidity and lock in
      // an arbitrary price ratio (including ones that trip the equilibrium
      // guard, drain the LP via donation, or set a price that benefits only the
      // attacker). Subsequent proportional add_liquidity remains permissionless.
      require(caller == self.owner, "not authorized")

      // [AUDIT-FIX CRIT-2] Use geometric mean (sqrt) instead of direct product
      // [SECURITY] M-6: Overflow guard — detect if amount_a * amount_b overflows.
      // After the multiplication, divide back: if product / amount_a != amount_b,
      // the product overflowed (wrapped to a small value).
      let product = amount_a * amount_b
      if amount_a > 0 {
        require(product / amount_a == amount_b, "amount_a * amount_b overflow")
      }
      let lp_raw = 0
      if product > 3 {
        let z = product
        let x = product / 2 + 1
        while x < z {
          z = x
          x = (product / x + x) / 2
        }
        lp_raw = z
      } else if product != 0 {
        lp_raw = 1
      }
      // [SECURITY] H-1: Validate FIRST (before any external call) so the user
      // doesn't lose their tokens if validation fails
      require(lp_raw > self.minimum_liquidity, "initial liquidity too low")

      // [AUDIT-FIX HIGH-1] Burn minimum_liquidity to dead address
      let lp = lp_raw - self.minimum_liquidity

      // [V2-AUDIT-FIX V2-CRIT-2] Revert atomically if min_lp not satisfied
      require(lp >= min_lp, "min_lp not satisfied")

      // [ARCH] Equilibrium price guard — consult factory for transitive price
      // validation against existing pools via the hub token. Factory returns
      // true (allow) if no hub path exists or computation overflows; reverts
      // (call returns false) if initial ratio diverges beyond tolerance.
      require(call(self.factory, "validate_initial_price", [self.token_a, self.token_b, amount_a, amount_b]), "equilibrium price check failed")

      // [S1-SP-02] Initial price ratio bounds — prevent extreme price manipulation
      // Price ratio = amount_a / amount_b (or inverse). Must be within [1/max, max].
      if self.max_initial_price_ratio > 0 {
        // Check amount_a/amount_b <= max AND amount_b/amount_a <= max
        // Equivalent to: amount_a <= amount_b * max AND amount_b <= amount_a * max
        require(amount_a <= amount_b * self.max_initial_price_ratio, "initial price ratio too high")
        require(amount_b <= amount_a * self.max_initial_price_ratio, "initial price ratio too low")
      }

      // [V7-CRIT-1] Now safe to pull tokens — all validations have passed
      // [S1-SP-01] Fee-on-transfer: measure actual received amount via balance-before/after
      let bal_a_before = call(self.token_a, "balance_of", [self_addr])
      require(call(self.token_a, "pull", [caller, self_addr, amount_a]), "token_a pull failed")
      let bal_a_after = call(self.token_a, "balance_of", [self_addr])
      let actual_a = bal_a_after - bal_a_before

      let bal_b_before = call(self.token_b, "balance_of", [self_addr])
      require(call(self.token_b, "pull", [caller, self_addr, amount_b]), "token_b pull failed")
      let bal_b_after = call(self.token_b, "balance_of", [self_addr])
      let actual_b = bal_b_after - bal_b_before

      // [V2-AUDIT-FIX V2-CRIT-1] CEI: all state changes before any external calls
      self.reserve_a = actual_a
      self.reserve_b = actual_b
      self.total_lp = lp_raw  // total including burned portion
      self.total_liquidity = lp

      // [V7] Create position for recipient
      let position_id = self.next_position_id
      self.next_position_id += 1
      let unlock_epoch = 0
      if lock_duration > 0 {
        unlock_epoch = epoch + lock_duration
      }
      self.position_owners[position_id] = recipient
      self.position_liquidities[position_id] = lp
      self.position_unlock_times[position_id] = unlock_epoch
      self.position_owner_count[recipient] += 1
      // [SECURITY] Link into user's position linked list (inlined — AML doesn't support self.fn() calls)
      require(self.user_position_prev[position_id] == 0 && self.user_position_next[position_id] == 0, "position already linked")
      let _prev_tail = self.user_tail_position[recipient]
      if _prev_tail == 0 {
        self.user_head_position[recipient] = position_id
        self.user_tail_position[recipient] = position_id
        self.user_position_prev[position_id] = 0
        self.user_position_next[position_id] = 0
      } else {
        self.user_position_next[_prev_tail] = position_id
        self.user_position_prev[position_id] = _prev_tail
        self.user_tail_position[recipient] = position_id
        self.user_position_next[position_id] = 0
      }
      // [SECURITY] C-1: Increment total_locked_lp if position was created with a lock
      // (regardless of whether the lock has since expired). Use lock_duration > 0 as
      // the source of truth to keep increment and decrement consistent.
      if lock_duration > 0 {
        self.total_locked_lp += lp
      }

      self.locked = false
      emit AddLiquidity(caller, amount_a, amount_b, lp)
      emit PositionAdded(position_id, recipient, lp, unlock_epoch)
      emit Sync(self.reserve_a, self.reserve_b)
      return (lp, amount_a, amount_b)
    }

    // [AUDIT-FIX F-1] Proportional add — overflow-guarded LP math (divide-back).
    // amount_x * total_lp can wrap int64 on large pools; verify by dividing back.
    let lp_prod_a = amount_a * self.total_lp
    if self.total_lp > 0 {
      require(lp_prod_a / amount_a == self.total_lp, "lp_a overflow")
    }
    let lp_a = lp_prod_a / self.reserve_a
    let lp_prod_b = amount_b * self.total_lp
    if self.total_lp > 0 {
      require(lp_prod_b / amount_b == self.total_lp, "lp_b overflow")
    }
    let lp_b = lp_prod_b / self.reserve_b
    let lp_amount = lp_a < lp_b ? lp_a : lp_b

    // [SECURITY] H-1: Validate FIRST (before any external call)
    require(lp_amount >= min_lp && lp_amount > 0, "min_lp not satisfied")

    let used_prod_a = lp_amount * self.reserve_a
    if lp_amount > 0 {
      require(used_prod_a / lp_amount == self.reserve_a, "used_a overflow")
    }
    let used_a = used_prod_a / self.total_lp
    let used_prod_b = lp_amount * self.reserve_b
    if lp_amount > 0 {
      require(used_prod_b / lp_amount == self.reserve_b, "used_b overflow")
    }
    let used_b = used_prod_b / self.total_lp

    // [V3-AUDIT-FIX] Prevent rounding to zero on contribution
    require(used_a > 0 && used_b > 0, "used amount cannot be zero due to rounding")

    // [AUDIT-FIX NEW-7] Validate used does not exceed what was provided
    require(used_a <= amount_a, "used_a exceeds amount_a")
    require(used_b <= amount_b, "used_b exceeds amount_b")

    let refund_a = amount_a - used_a
    let refund_b = amount_b - used_b

    // [V7-CRIT-1] Now safe to pull tokens — all validations have passed
    // [S1-SP-01] Fee-on-transfer: measure actual received amount
    let bal_a_before = call(self.token_a, "balance_of", [self_addr])
    require(call(self.token_a, "pull", [caller, self_addr, amount_a]), "token_a pull failed")
    let bal_a_after = call(self.token_a, "balance_of", [self_addr])
    let actual_a = bal_a_after - bal_a_before

    let bal_b_before = call(self.token_b, "balance_of", [self_addr])
    require(call(self.token_b, "pull", [caller, self_addr, amount_b]), "token_b pull failed")
    let bal_b_after = call(self.token_b, "balance_of", [self_addr])
    let actual_b = bal_b_after - bal_b_before

    // Use actual received amounts for reserve accounting
    require(actual_a >= used_a, "token_a fee-on-transfer: received less than used")
    require(actual_b >= used_b, "token_b fee-on-transfer: received less than used")

    // [V2-AUDIT-FIX V2-CRIT-1] CEI: update state BEFORE any external calls
    self.reserve_a += actual_a
    self.reserve_b += actual_b
    self.total_lp += lp_amount
    self.total_liquidity += lp_amount

    // [V7] Create position for recipient
    let position_id = self.next_position_id
    self.next_position_id += 1
    let unlock_epoch = 0
    if lock_duration > 0 {
      unlock_epoch = epoch + lock_duration
    }
    self.position_owners[position_id] = recipient
    self.position_liquidities[position_id] = lp_amount
    self.position_unlock_times[position_id] = unlock_epoch
    self.position_owner_count[recipient] += 1
    // [SECURITY] Link into user's position linked list (inlined — AML doesn't support self.fn() calls)
    require(self.user_position_prev[position_id] == 0 && self.user_position_next[position_id] == 0, "position already linked")
    let _prev_tail = self.user_tail_position[recipient]
    if _prev_tail == 0 {
      self.user_head_position[recipient] = position_id
      self.user_tail_position[recipient] = position_id
      self.user_position_prev[position_id] = 0
      self.user_position_next[position_id] = 0
    } else {
      self.user_position_next[_prev_tail] = position_id
      self.user_position_prev[position_id] = _prev_tail
      self.user_tail_position[recipient] = position_id
      self.user_position_next[position_id] = 0
    }
    // [SECURITY] C-1: Increment total_locked_lp if position was created with a lock
    if lock_duration > 0 {
      self.total_locked_lp += lp_amount
    }

    // [SECURITY] C-1: Reentrancy fix — emit events FIRST but keep `locked = true` through
    // the external refund calls. The single-bool reentrancy guard must remain held
    // until ALL external calls are complete.
    emit AddLiquidity(caller, used_a, used_b, lp_amount)
    emit PositionAdded(position_id, recipient, lp_amount, unlock_epoch)
    emit Sync(self.reserve_a, self.reserve_b)

    // Refund excess tokens AFTER state is fully committed, while still holding lock
    if refund_a > 0 {
      require(call(self.token_a, "transfer", [caller, refund_a]), "token_a refund failed")
    }
    if refund_b > 0 {
      require(call(self.token_b, "transfer", [caller, refund_b]), "token_b refund failed")
    }

    // Only release the lock AFTER all external calls are complete
    self.locked = false

    return (lp_amount, used_a, used_b)
  }

  // [V11] Direct-entry wrapper: caller adds liquidity for themselves.
  fn add_liquidity(amount_a: int, amount_b: int, min_lp: int, deadline: int, lock_duration: int): (int, int, int) {
    return add_liquidity_for(caller, amount_a, amount_b, min_lp, deadline, lock_duration)
  }

  fn remove_liquidity(position_id: int, min_a: int, min_b: int, deadline: int): (int, int) {
    // [V7-CRIT-4] Enforce 5-minute deadline
    require(deadline > epoch && deadline <= epoch + 300, "deadline must be 1-300 seconds from now")
    require(self.active, "pool not active")
    require(!self.locked, "reentrancy guard")
    require(position_id > 0, "invalid position id")
    require(self.position_owners[position_id] == caller, "not position owner")
    require(self.total_lp > 0, "no liquidity")

    let lp_amount = self.position_liquidities[position_id]
    let unlock_time = self.position_unlock_times[position_id]
    require(lp_amount > 0, "position not found")
    // [V7] Enforce lock time per position
    require(epoch >= unlock_time, "liquidity is locked")

    self.locked = true

    // [AUDIT-FIX F-1] Overflow-guarded LP math (divide-back)
    let amt_prod_a = lp_amount * self.reserve_a
    if lp_amount > 0 {
      require(amt_prod_a / lp_amount == self.reserve_a, "amount_a overflow")
    }
    let amount_a = amt_prod_a / self.total_lp
    let amt_prod_b = lp_amount * self.reserve_b
    if lp_amount > 0 {
      require(amt_prod_b / lp_amount == self.reserve_b, "amount_b overflow")
    }
    let amount_b = amt_prod_b / self.total_lp
    require(amount_a > 0 && amount_b > 0, "zero output")

    require(amount_a >= min_a, "amount_a below minimum")
    require(amount_b >= min_b, "amount_b below minimum")

    // [AUDIT-FIX] CEI: Update state before transfer
    self.position_owners[position_id] = ""
    self.position_liquidities[position_id] = 0
    self.position_unlock_times[position_id] = 0
    self.total_lp -= lp_amount
    self.total_liquidity -= lp_amount

    self.position_owner_count[caller] -= 1
    // [SECURITY] Unlink from user's position linked list (inlined — AML doesn't support self.fn() calls)
    // M-7: Defense-in-depth — verify position is in the owner's list before unlinking
    let _current_pos = self.user_head_position[caller]
    let _match_found = false
    let _scan_count = 0
    while _current_pos != 0 && _scan_count < 10001 {
      if _current_pos == position_id {
        _match_found = true
      }
      _current_pos = self.user_position_next[_current_pos]
      _scan_count += 1
    }
    if !_match_found {
      self.user_position_prev[position_id] = 0
      self.user_position_next[position_id] = 0
    } else {
      let _prev_pos = self.user_position_prev[position_id]
      let _next_pos = self.user_position_next[position_id]
      if _prev_pos != 0 {
        self.user_position_next[_prev_pos] = _next_pos
      }
      if _next_pos != 0 {
        self.user_position_prev[_next_pos] = _prev_pos
      }
      if self.user_head_position[caller] == position_id {
        self.user_head_position[caller] = _next_pos
      }
      if self.user_tail_position[caller] == position_id {
        self.user_tail_position[caller] = _prev_pos
      }
      self.user_position_prev[position_id] = 0
      self.user_position_next[position_id] = 0
    }
    // [SECURITY] C-1: Decrement total_locked_lp if position was created with a lock
    // (i.e., unlock_time > 0). This is consistent with the increment in add_liquidity
    // which checks lock_duration > 0. Using unlock_time > 0 here means we decrement
    // even after the lock has expired, keeping the total accurate.
    if unlock_time > 0 {
      self.total_locked_lp -= lp_amount
    }

    require(self.reserve_a >= amount_a, "reserve_a underflow")
    require(self.reserve_b >= amount_b, "reserve_b underflow")

    self.reserve_a -= amount_a
    self.reserve_b -= amount_b

    // [V7-CRIT-1] Validate transfer succeeded
    require(call(self.token_a, "transfer", [caller, amount_a]), "token_a transfer failed")
    require(call(self.token_b, "transfer", [caller, amount_b]), "token_b transfer failed")

    self.locked = false
    emit RemoveLiquidity(caller, amount_a, amount_b, lp_amount)
    emit PositionRemoved(position_id, caller, lp_amount)
    emit Sync(self.reserve_a, self.reserve_b)
    return (amount_a, amount_b)
  }

  fn close_position(min_a: int, min_b: int, deadline: int): (int, int) {
    // [V7-CRIT-4] Enforce 5-minute deadline
    require(deadline > epoch && deadline <= epoch + 300, "deadline must be 1-300 seconds from now")
    require(self.active, "pool not active")
    require(!self.locked, "reentrancy guard")
    require(self.total_lp > 0, "no liquidity")

    let position_count = self.position_owner_count[caller]
    require(position_count > 0, "no positions")

    // Find first unlocked position via indexed linked list (avoids gas bomb)
    let position_id = 0
    // [SECURITY] Hoisted outside while loop so the value persists past the loop scope
    // and refers to the matched position (not the next position in the list)
    let unlock_time = 0
    let found = false
    let pos_id = self.user_head_position[caller]
    while pos_id != 0 && !found {
      let liquidity = self.position_liquidities[pos_id]
      let pos_unlock = self.position_unlock_times[pos_id]
      if liquidity > 0 && epoch >= pos_unlock {
        position_id = pos_id
        // [SECURITY] Capture the unlock time of the MATCHED position
        unlock_time = pos_unlock
        found = true
      }
      pos_id = self.user_position_next[pos_id]
    }
    require(found, "no unlocked positions")

    let lp_bal = self.position_liquidities[position_id]

    self.locked = true

    // [AUDIT-FIX F-1] Overflow-guarded LP math (divide-back)
    let amt_prod_a = lp_bal * self.reserve_a
    if lp_bal > 0 {
      require(amt_prod_a / lp_bal == self.reserve_a, "amount_a overflow")
    }
    let amount_a = amt_prod_a / self.total_lp
    let amt_prod_b = lp_bal * self.reserve_b
    if lp_bal > 0 {
      require(amt_prod_b / lp_bal == self.reserve_b, "amount_b overflow")
    }
    let amount_b = amt_prod_b / self.total_lp
    require(amount_a > 0 && amount_b > 0, "zero output")

    require(amount_a >= min_a, "amount_a below minimum")
    require(amount_b >= min_b, "amount_b below minimum")

    // [AUDIT-FIX] CEI pattern: update state first
    self.position_owners[position_id] = ""
    self.position_liquidities[position_id] = 0
    self.position_unlock_times[position_id] = 0
    self.total_lp -= lp_bal
    self.total_liquidity -= lp_bal

    self.position_owner_count[caller] -= 1
    // [SECURITY] Unlink from user's position linked list (inlined — AML doesn't support self.fn() calls)
    // M-7: Defense-in-depth — verify position is in the owner's list before unlinking
    let _current_pos = self.user_head_position[caller]
    let _match_found = false
    let _scan_count = 0
    while _current_pos != 0 && _scan_count < 10001 {
      if _current_pos == position_id {
        _match_found = true
      }
      _current_pos = self.user_position_next[_current_pos]
      _scan_count += 1
    }
    if !_match_found {
      self.user_position_prev[position_id] = 0
      self.user_position_next[position_id] = 0
    } else {
      let _prev_pos = self.user_position_prev[position_id]
      let _next_pos = self.user_position_next[position_id]
      if _prev_pos != 0 {
        self.user_position_next[_prev_pos] = _next_pos
      }
      if _next_pos != 0 {
        self.user_position_prev[_next_pos] = _prev_pos
      }
      if self.user_head_position[caller] == position_id {
        self.user_head_position[caller] = _next_pos
      }
      if self.user_tail_position[caller] == position_id {
        self.user_tail_position[caller] = _prev_pos
      }
      self.user_position_prev[position_id] = 0
      self.user_position_next[position_id] = 0
    }
    // [SECURITY] C-1: Decrement total_locked_lp if position was created with a lock
    if unlock_time > 0 {
      self.total_locked_lp -= lp_bal
    }

    require(self.reserve_a >= amount_a, "reserve_a underflow")
    require(self.reserve_b >= amount_b, "reserve_b underflow")

    self.reserve_a -= amount_a
    self.reserve_b -= amount_b

    // [V7-CRIT-1] Validate transfer succeeded
    require(call(self.token_a, "transfer", [caller, amount_a]), "token_a transfer failed")
    require(call(self.token_b, "transfer", [caller, amount_b]), "token_b transfer failed")

    self.locked = false
    emit RemoveLiquidity(caller, amount_a, amount_b, lp_bal)
    emit PositionRemoved(position_id, caller, lp_bal)
    emit Sync(self.reserve_a, self.reserve_b)
    return (amount_a, amount_b)
  }

  fn swap_a_for_b(amount_in: int, min_out: int, deadline: int): int {
    // [V7-CRIT-4] Enforce 5-minute deadline
    require(deadline > epoch && deadline <= epoch + 300, "deadline must be 1-300 seconds from now")
    require(self.active, "pool not active")
    require(!self.locked, "reentrancy guard")
    require(amount_in > 0, "zero input")
    require(self.reserve_a > 0 && self.reserve_b > 0, "no liquidity")
    require(self.token_a != "" && self.token_b != "", "tokens not set")

    self.locked = true

    // [V7-CRIT-1] Validate pull succeeded
    // [S1-SP-03] Fee-on-transfer: measure actual received amount
    let bal_before = call(self.token_a, "balance_of", [self_addr])
    require(call(self.token_a, "pull", [caller, self_addr, amount_in]), "token_a pull failed")
    let bal_after = call(self.token_a, "balance_of", [self_addr])
    let actual_in = bal_after - bal_before
    require(actual_in > 0, "zero tokens received (fee-on-transfer)")

    // [SECURITY] H-2: Overflow guard for fee calculation
    // actual_in * fee_numerator can overflow int64. Check by dividing back.
    let raw_fee = actual_in * self.fee_numerator
    if self.fee_numerator > 0 {
      require(raw_fee / self.fee_numerator == actual_in, "fee amount overflow")
    }
    let fee_amount = raw_fee / self.fee_denominator
    let amount_in_after_fee = actual_in - fee_amount

    // [SECURITY] H-10: Overflow guard for out calculation
    // amount_in_after_fee * reserve_b can overflow
    let raw_out = amount_in_after_fee * self.reserve_b
    if amount_in_after_fee > 0 {
      require(raw_out / amount_in_after_fee == self.reserve_b, "out calculation overflow")
    }
    let out = raw_out / (self.reserve_a + amount_in_after_fee)

    require(out >= min_out, "slippage too high")
    require(out > 0, "output too small")
    // [SECURITY] M-11: Minimum liquidity floor — prevent complete pool drainage.
    // After the swap, the output reserve must remain above 1000 to allow future
    // swaps (rounding would otherwise produce 0 output).
    require(out < self.reserve_b - 1000, "swap would drain pool below minimum liquidity")

    // [SECURITY] H-5: Overflow guard — ensure k_before computation doesn't overflow
    // k = reserve_a * reserve_b. With int64 max ~9.2e18, the multiplication
    // overflows when both reserves exceed ~3e9. The guards below cap reserves safely.
    let k_before = self.reserve_a * self.reserve_b
    // Sanity check: if multiplication overflows, k_before wraps and is much smaller
    // than expected, so k_after >= k_before still passes incorrectly. Re-check by
    // dividing back: if k_before / reserve_a != reserve_b, it overflowed.
    if self.reserve_a > 0 {
      require(k_before / self.reserve_a == self.reserve_b, "reserve overflow detected")
    }

    self.reserve_a += amount_in_after_fee
    // [SECURITY] M-5: Overflow guard on fee accumulation
    let new_fee_a = self.fee_reserve_a + fee_amount
    require(new_fee_a > self.fee_reserve_a, "fee_reserve_a overflow")
    self.fee_reserve_a = new_fee_a

    require(self.reserve_b > out, "reserve_b underflow")
    self.reserve_b -= out

    let k_after = self.reserve_a * self.reserve_b
    if self.reserve_a > 0 {
      require(k_after / self.reserve_a == self.reserve_b, "post-swap overflow")
    }
    require(k_after >= k_before, "invariant violation")

    // [V7-CRIT-1] Validate transfer succeeded
    require(call(self.token_b, "transfer", [caller, out]), "token_b transfer failed")

    // [SECURITY] Update TWAP before emitting events
    if self.twap_last_update_epoch > 0 && self.reserve_a > 0 && self.reserve_b > 0 {
      let twap_elapsed = epoch - self.twap_last_update_epoch
      if twap_elapsed > 0 {
        let twap_price_a = self.reserve_b * 1000000 / self.reserve_a
        let twap_price_b = self.reserve_a * 1000000 / self.reserve_b
        self.twap_price_cumulative_a += twap_price_a * twap_elapsed
        self.twap_price_cumulative_b += twap_price_b * twap_elapsed
      }
    }
    self.twap_last_update_epoch = epoch

    self.locked = false
    emit Swap(caller, self.token_a, amount_in, out)
    emit Sync(self.reserve_a, self.reserve_b)
    return out
  }

  fn swap_b_for_a(amount_in: int, min_out: int, deadline: int): int {
    // [V7-CRIT-4] Enforce 5-minute deadline
    require(deadline > epoch && deadline <= epoch + 300, "deadline must be 1-300 seconds from now")
    require(self.active, "pool not active")
    require(!self.locked, "reentrancy guard")
    require(amount_in > 0, "zero input")
    require(self.reserve_a > 0 && self.reserve_b > 0, "no liquidity")
    require(self.token_a != "" && self.token_b != "", "tokens not set")

    self.locked = true

    // [V7-CRIT-1] Validate pull succeeded
    // [S1-SP-03] Fee-on-transfer: measure actual received amount
    let bal_before = call(self.token_b, "balance_of", [self_addr])
    require(call(self.token_b, "pull", [caller, self_addr, amount_in]), "token_b pull failed")
    let bal_after = call(self.token_b, "balance_of", [self_addr])
    let actual_in = bal_after - bal_before
    require(actual_in > 0, "zero tokens received (fee-on-transfer)")

    // [SECURITY] H-2: Overflow guard for fee calculation
    let raw_fee = actual_in * self.fee_numerator
    if self.fee_numerator > 0 {
      require(raw_fee / self.fee_numerator == actual_in, "fee amount overflow")
    }
    let fee_amount = raw_fee / self.fee_denominator
    let amount_in_after_fee = actual_in - fee_amount

    // [SECURITY] H-10: Overflow guard for out calculation
    let raw_out = amount_in_after_fee * self.reserve_a
    if amount_in_after_fee > 0 {
      require(raw_out / amount_in_after_fee == self.reserve_a, "out calculation overflow")
    }
    let out = raw_out / (self.reserve_b + amount_in_after_fee)

    require(out >= min_out, "slippage too high")
    require(out > 0, "output too small")
    // [SECURITY] M-11: Minimum liquidity floor (see swap_a_for_b)
    require(out < self.reserve_a - 1000, "swap would drain pool below minimum liquidity")

    // [SECURITY] H-5: Overflow guard (see swap_a_for_b)
    let k_before = self.reserve_a * self.reserve_b
    if self.reserve_a > 0 {
      require(k_before / self.reserve_a == self.reserve_b, "reserve overflow detected")
    }

    self.reserve_b += amount_in_after_fee
    // [SECURITY] M-5: Overflow guard on fee accumulation
    let new_fee_b = self.fee_reserve_b + fee_amount
    require(new_fee_b > self.fee_reserve_b, "fee_reserve_b overflow")
    self.fee_reserve_b = new_fee_b

    require(self.reserve_a > out, "reserve_a underflow")
    self.reserve_a -= out

    let k_after = self.reserve_a * self.reserve_b
    if self.reserve_a > 0 {
      require(k_after / self.reserve_a == self.reserve_b, "post-swap overflow")
    }
    require(k_after >= k_before, "invariant violation")

    // [V7-CRIT-1] Validate transfer succeeded
    require(call(self.token_a, "transfer", [caller, out]), "token_a transfer failed")

    // [SECURITY] Update TWAP before emitting events
    if self.twap_last_update_epoch > 0 && self.reserve_a > 0 && self.reserve_b > 0 {
      let twap_elapsed = epoch - self.twap_last_update_epoch
      if twap_elapsed > 0 {
        let twap_price_a = self.reserve_b * 1000000 / self.reserve_a
        let twap_price_b = self.reserve_a * 1000000 / self.reserve_b
        self.twap_price_cumulative_a += twap_price_a * twap_elapsed
        self.twap_price_cumulative_b += twap_price_b * twap_elapsed
      }
    }
    self.twap_last_update_epoch = epoch

    self.locked = false
    emit Swap(caller, self.token_b, amount_in, out)
    emit Sync(self.reserve_a, self.reserve_b)
    return out
  }

  // [SECURITY] TWAP view — returns time-weighted average price
  view fn get_twap(): (int, int) {
    if self.twap_last_update_epoch == 0 || self.reserve_a == 0 || self.reserve_b == 0 {
      return (0, 0)
    }
    let elapsed = epoch - self.twap_last_update_epoch
    if elapsed == 0 { elapsed = 1 }
    let avg_a = self.twap_price_cumulative_a / elapsed
    let avg_b = self.twap_price_cumulative_b / elapsed
    return (avg_a, avg_b)
  }

  // [SECURITY] Rescue stuck tokens — only excess beyond tracked reserves
  fn rescue_tokens(token: address, amount: int, to: address): bool {
    require(caller == self.owner, "not authorized")
    require(!self.locked, "reentrancy guard")
    require(token != "", "zero token address")
    require(to != "", "zero recipient")
    require(amount > 0, "zero amount")
    // Calculate tracked balance (reserves + fees for both tokens)
    let tracked = 0
    if token == self.token_a {
      tracked = self.reserve_a + self.fee_reserve_a
    } else if token == self.token_b {
      tracked = self.reserve_b + self.fee_reserve_b
    }
    let actual_bal = call(token, "balance_of", [self_addr])
    require(actual_bal > tracked, "no excess tokens to rescue")
    let rescueable = actual_bal - tracked
    require(amount <= rescueable, "amount exceeds rescueable balance")
    require(call(token, "transfer", [to, amount]), "rescue transfer failed")
    return true
  }

  fn sync(): bool {
    require(caller == self.owner, "not authorized")
    require(!self.locked, "reentrancy guard")
    self.locked = true
    // [V7-CRIT-1] Validate balance_of calls succeeded
    let bal_a = call(self.token_a, "balance_of", [self_addr])
    let bal_b = call(self.token_b, "balance_of", [self_addr])
    require(bal_a >= self.reserve_a && bal_b >= self.reserve_b, "sync would reduce reserves")
    // [AUDIT-FIX M-1] Reserves must EXCLUDE accumulated fees (fee_reserve_a/b) and
    // any donated tokens. Setting reserve = full balance double-counts fee tokens
    // that are also tracked separately for claim_fees(), inflating LP payouts.
    require(bal_a >= self.fee_reserve_a, "bal_a < fee_reserve_a")
    require(bal_b >= self.fee_reserve_b, "bal_b < fee_reserve_b")
    self.reserve_a = bal_a - self.fee_reserve_a
    self.reserve_b = bal_b - self.fee_reserve_b
    self.locked = false
    emit Sync(self.reserve_a, self.reserve_b)
    return true
  }

  // [V4-AUDIT-FIX] claim_fees: Allow owner to specify recipient so fees can be sent directly to a treasury
  // or a fee distributor contract.
  // [SECURITY] C-1: Strict CEI — external transfer happens FIRST, fee reserves are zeroed
  // only AFTER successful transfers. If a transfer reverts, the fees are preserved.
  fn claim_fees(recipient: address): bool {
    require(caller == self.owner, "not authorized")
    // [SECURITY] H-6: Reentrancy check at the very top
    require(!self.locked, "reentrancy guard")
    self.locked = true
    assert_address(recipient)
    require(recipient != "", "zero address")
    // [SECURITY] L-1: Reject self-recipient to avoid stuck fees
    require(recipient != self_addr, "recipient cannot be pool")
    // [SECURITY] M-2: Reject recipient being one of the pool's tokens
    // (fees would be locked in the token contract)
    require(recipient != self.token_a && recipient != self.token_b, "recipient cannot be pool's tokens")
    // [SECURITY] R-9: Reject recipient being the factory or WOCT (cross-contract confusion)
    // — covered by M-2 check above (factory and WOCT are token contracts)

    let amt_a = self.fee_reserve_a
    let amt_b = self.fee_reserve_b
    require(amt_a > 0 || amt_b > 0, "no fees to claim")

    // [SECURITY] C-1: Do external transfers FIRST. If they fail (e.g., recipient
    // blacklisted, fee-on-transfer token, or recipient contract reverts), the
    // whole transaction reverts and the fee reserves are preserved.
    if amt_a > 0 {
      require(call(self.token_a, "transfer", [recipient, amt_a]), "token_a fee transfer failed")
    }
    if amt_b > 0 {
      require(call(self.token_b, "transfer", [recipient, amt_b]), "token_b fee transfer failed")
    }

    // [SECURITY] C-1: Only NOW zero the fee reserves — after successful transfers
    self.fee_reserve_a = 0
    self.fee_reserve_b = 0

    self.locked = false
    emit FeesClaimed(recipient, amt_a, amt_b)
    return true
  }

  fn set_active(status: bool): bool {
    require(caller == self.owner, "not authorized")
    // [SECURITY] H-5: Add reentrancy guard for state changes
    require(!self.locked, "reentrancy guard")
    // [SECURITY] Skip event emit if state unchanged (avoid event spam)
    if self.active != status {
      self.active = status
      emit PoolActivated(status)
    }
    return true
  }

  // [S1-SP-02] Set maximum initial price ratio (owner only)
  // [AUDIT-FIX M-5] Added event emission
  event MaxInitialPriceRatioSet(old_ratio: int, new_ratio: int)
  fn set_max_initial_price_ratio(ratio: int): bool {
    require(caller == self.owner, "not authorized")
    require(!self.locked, "reentrancy guard")
    require(ratio >= 0, "ratio cannot be negative")
    let old_ratio = self.max_initial_price_ratio
    self.max_initial_price_ratio = ratio
    emit MaxInitialPriceRatioSet(old_ratio, ratio)
    return true
  }

  fn transfer_ownership(new_owner: address): bool {
    require(caller == self.owner, "not authorized")
    // [SECURITY] H-5: Add reentrancy guard
    require(!self.locked, "reentrancy guard")
    assert_address(new_owner)
    require(new_owner != "", "new owner is zero address")
    self.pending_owner = new_owner
    emit OwnershipTransferProposed(self.owner, new_owner)
    return true
  }

  fn accept_ownership(): bool {
    require(caller == self.pending_owner, "not pending owner")
    require(self.pending_owner != "", "no pending transfer")
    // [SECURITY] H-5: Add reentrancy guard
    require(!self.locked, "reentrancy guard")
    let old_owner = self.owner
    self.owner = self.pending_owner
    // [SECURITY] Reset pending_owner to empty string (not origin) to prevent ownership hijack
    self.pending_owner = ""
    emit OwnershipTransferred(old_owner, self.owner)
    return true
  }

  fn set_fee_params(num: int, denom: int): bool {
    require(caller == self.owner, "not authorized")
    // [AUDIT-FIX F-7] Consistent reentrancy guard (parity with other setters)
    require(!self.locked, "reentrancy guard")
    require(denom > 0, "denominator must be > 0")
    require(num > 0, "numerator must be > 0")
    require(num < denom, "fee must be < 100%")
    require(num * 1000 <= denom * 10, "fee cannot exceed 1%")
    // [SECURITY] M-2: Minimum fee floor of 0.03% (3/10000) to prevent
    // JIT sandwich attacks against pools with negligible fees
    require(num * 10000 >= denom * 3, "fee too low (min 0.03%)")
    let old_num = self.fee_numerator
    let old_denom = self.fee_denominator
    self.fee_numerator = num
    self.fee_denominator = denom
    // [SECURITY] M-8: Emit event for transparency
    emit FeeParamsSet(old_num, old_denom, num, denom)
    return true
  }

  view fn get_reserves(): (int, int) {
    return (self.reserve_a, self.reserve_b)
  }

  view fn get_price_a_in_b(): int {
    require(self.reserve_a > 0 && self.reserve_b > 0, "no liquidity")
    return self.reserve_b * 1000000 / self.reserve_a
  }

  view fn get_price(): int {
    require(self.reserve_a > 0 && self.reserve_b > 0, "no liquidity")
    return self.reserve_b * 1000000 / self.reserve_a
  }

  view fn get_amount_out(amount_in: int, is_a_to_b: bool): int {
    require(amount_in > 0, "zero input")
    require(self.reserve_a > 0 && self.reserve_b > 0, "no liquidity")
    // [SECURITY] H-7: Overflow guard for fee and out calculation
    let raw_fee = amount_in * self.fee_numerator
    if self.fee_numerator > 0 {
      require(raw_fee / self.fee_numerator == amount_in, "fee overflow")
    }
    let fee_amount = raw_fee / self.fee_denominator
    let amount_in_after_fee = amount_in - fee_amount
    if is_a_to_b {
      let raw_out = amount_in_after_fee * self.reserve_b
      if amount_in_after_fee > 0 {
        require(raw_out / amount_in_after_fee == self.reserve_b, "out overflow")
      }
      return raw_out / (self.reserve_a + amount_in_after_fee)
    }
    let raw_out2 = amount_in_after_fee * self.reserve_a
    if amount_in_after_fee > 0 {
      require(raw_out2 / amount_in_after_fee == self.reserve_a, "out overflow")
    }
    return raw_out2 / (self.reserve_b + amount_in_after_fee)
  }

  view fn get_lp_balance(addr: address): int {
    let total = 0
    let pos_id = self.user_head_position[addr]
    while pos_id != 0 {
      total += self.position_liquidities[pos_id]
      pos_id = self.user_position_next[pos_id]
    }
    return total
  }

  view fn total_lp_supply(): int {
    return self.total_lp
  }

  view fn get_pool_info(): (address, address, int, int, int, bool, int) {
    return (self.token_a, self.token_b, self.reserve_a, self.reserve_b, self.total_lp, self.active, self.next_position_id)
  }

  view fn get_token_a(): address {
    return self.token_a
  }

  view fn get_token_b(): address {
    return self.token_b
  }

  view fn get_k(): int {
    // [AUDIT-FIX M-3] Overflow guard — mirror the pattern used in get_amount_out.
    // reserve_a * reserve_b can wrap with large reserves; detect via divide-back.
    let product = self.reserve_a * self.reserve_b
    if self.reserve_a > 0 {
      require(product / self.reserve_a == self.reserve_b, "k overflow")
    }
    return product
  }

  view fn get_fee_reserves(): (int, int) {
    return (self.fee_reserve_a, self.fee_reserve_b)
  }

  view fn get_fee_params(): (int, int) {
    return (self.fee_numerator, self.fee_denominator)
  }

  view fn get_pending_owner(): address {
    return self.pending_owner
  }

  // [V12] Scalar getters required by SwapFactory.remove_pool().
  // Previously remove_pool() called `owner`, `reserve_a`, `reserve_b` and
  // `total_lp` directly — but those are bare storage fields, NOT callable
  // functions, so every remove_pool() reverted at the first call() with
  // "method not found". The feature never worked for anyone.
  //   These are deliberately SCALAR (not tuples): no call() site anywhere in
  // this codebase consumes a tuple-returning function, and AML has no
  // destructuring syntax (`let (a, b) = ...`), so get_reserves() cannot be used
  // from remove_pool(). Naming follows the get_* convention already used by
  // Token.aml's get_owner().
  view fn get_owner(): address {
    return self.owner
  }

  view fn is_active(): bool {
    return self.active
  }

  view fn get_reserve_a(): int {
    return self.reserve_a
  }

  view fn get_reserve_b(): int {
    return self.reserve_b
  }

  view fn get_fee_numerator(): int {
    return self.fee_numerator
  }

  view fn get_fee_denominator(): int {
    return self.fee_denominator
  }

  // [V12] User-owned LP supply, EXCLUDING the minimum_liquidity that is burned
  // to the dead address on the first add_liquidity (Uniswap-V2 style). This is
  // the correct "is the pool drained of user funds?" signal for remove_pool():
  // total_lp can NEVER return to 0 once seeded (it keeps the burned minimum,
  // plus dust reserves back it), but total_liquidity DOES reach 0 once every
  // user position is withdrawn.
  view fn get_total_liquidity(): int {
    return self.total_liquidity
  }

  // [V7] Position-based view functions
  view fn get_position(id: int): (address, int, int) {
    return (self.position_owners[id], self.position_liquidities[id], self.position_unlock_times[id])
  }

  view fn get_position_count(addr: address): int {
    return self.position_owner_count[addr]
  }

  view fn get_unlocked_liquidity(addr: address): int {
    let total = 0
    let pos_id = self.user_head_position[addr]
    while pos_id != 0 {
      if epoch >= self.position_unlock_times[pos_id] {
        total += self.position_liquidities[pos_id]
      }
      pos_id = self.user_position_next[pos_id]
    }
    return total
  }

  view fn get_locked_liquidity(addr: address): int {
    let total = 0
    let pos_id = self.user_head_position[addr]
    while pos_id != 0 {
      if epoch < self.position_unlock_times[pos_id] {
        total += self.position_liquidities[pos_id]
      }
      pos_id = self.user_position_next[pos_id]
    }
    return total
  }

  view fn get_total_locked_lp(): int {
    // [SECURITY] O(1) incremental tracking — no DoS
    return self.total_locked_lp
  }

  view fn get_position_unlock_time(id: int): int {
    return self.position_unlock_times[id]
  }

  view fn get_next_position_id(): int {
    return self.next_position_id
  }

  view fn get_max_positions_per_user(): int {
    return self.max_positions_per_user
  }

  fn set_max_positions_per_user(limit: int): bool {
    require(caller == self.owner, "not authorized")
    // [AUDIT-FIX F-7] Consistent reentrancy guard (parity with other setters)
    require(!self.locked, "reentrancy guard")
    require(limit > 0, "limit must be positive")
    // [SECURITY] H-1: Upper bound to prevent DoS via gas-bomb in view calls
    // (get_lp_balance, get_locked_liquidity, get_unlocked_liquidity all traverse the
    // per-user linked list). 10000 is a reasonable upper limit.
    require(limit <= 10000, "limit too high (max 10000)")
    self.max_positions_per_user = limit
    // [SECURITY] M-1: Emit event for transparency
    emit MaxPositionsPerUserUpdated(limit)
    return true
  }
}
