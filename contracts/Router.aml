contract Router {
  state {
    factory: address
    woct: address
    owner: address
    // [AUDIT-FIX NEW-34] Pause dan whitelist token
    paused: bool
    // [AUDIT-FIX NEW-35] Slippage tolerance maksimum global (dalam basis points, 10000 = 100%)
    // [V2-HIGH-9 / V2-LOW-7] max_slippage_bps is now actively enforced in swap_exact_tokens_for_tokens.
    max_slippage_bps: int
    // [V7-CRIT-8] Two-step ownership transfer
    pending_owner: address
    // [S1-RT-01] Timelock for factory/woct changes (24h = 14400 epochs)
    pending_factory: address
    pending_woct: address
    pending_factory_epoch: int
    pending_woct_epoch: int
  }

  event SwapExact(who: address, token_in: address, token_out: address, amount_in: int, amount_out: int)
  // [MULTI-HOP] Event for path-based swaps
  event SwapExactPath(who: address, path_len: int, amount_in: int, amount_out: int)
  // [AUDIT-FIX NEW-34] Pause event
  event Paused(status: bool)
  // [V7-CRIT-8] Two-step ownership events
  event OwnershipTransferProposed(current_owner: address, proposed_owner: address)
  event OwnershipTransferred(old_owner: address, new_owner: address)
  // [SECURITY] M-9: Event for max slippage updates
  event MaxSlippageBpsSet(old_bps: int, new_bps: int)
  // [S1-RT-01] Timelock events for factory/woct changes
  event FactoryChangeProposed(old_factory: address, new_factory: address, effective_epoch: int)
  event FactoryChanged(old_factory: address, new_factory: address)
  event WoctChangeProposed(old_woct: address, new_woct: address, effective_epoch: int)
  event WoctChanged(old_woct: address, new_woct: address)

  constructor() {
    self.factory = origin
    self.woct = origin
    // [AUDIT-FIX LOW-1] Simpan owner di state dari constructor
    self.owner = origin
    self.paused = false
    // [AUDIT-FIX F-3] Default max slippage: 10% (1000 bps), aligned with setter cap
    // and docs. Previous 50% default left single-hop swaps exposed to sandwich until
    // the owner lowered it.
    self.max_slippage_bps = 1000
    // [V7-CRIT-8] Two-step ownership: no pending owner at start
    self.pending_owner = ""
    // [S1-RT-01] No pending factory/woct changes at start
    self.pending_factory = ""
    self.pending_woct = ""
    self.pending_factory_epoch = 0
    self.pending_woct_epoch = 0
  }

  // [DEPLOY] One-time initialization for fresh deploys (bypasses timelock)
  fn init(factory_addr: address, woct_addr: address): bool {
    require(caller == self.owner, "not authorized")
    require(self.factory == origin, "already initialized")
    assert_address(factory_addr)
    assert_address(woct_addr)
    require(factory_addr != "", "zero factory")
    require(woct_addr != "", "zero woct")
    self.factory = factory_addr
    self.woct = woct_addr
    return true
  }

  // [S1-RT-01] Factory change with 24h timelock
  fn propose_factory(addr: address): bool {
    require(caller == self.owner, "not authorized")
    assert_address(addr)
    require(addr != "", "zero address")
    require(addr != self.factory, "same address")
    self.pending_factory = addr
    self.pending_factory_epoch = epoch + 14400
    emit FactoryChangeProposed(self.factory, addr, self.pending_factory_epoch)
    return true
  }

  fn accept_factory(): bool {
    require(caller == self.owner, "not authorized")
    require(self.pending_factory != "", "no pending change")
    require(epoch >= self.pending_factory_epoch, "timelock not elapsed")
    let old = self.factory
    self.factory = self.pending_factory
    self.pending_factory = ""
    self.pending_factory_epoch = 0
    emit FactoryChanged(old, self.factory)
    return true
  }

  fn cancel_factory_change(): bool {
    require(caller == self.owner, "not authorized")
    self.pending_factory = ""
    self.pending_factory_epoch = 0
    return true
  }

  // [S1-RT-01] WOCT change with 24h timelock
  fn propose_woct(addr: address): bool {
    require(caller == self.owner, "not authorized")
    assert_address(addr)
    require(addr != "", "zero address")
    require(addr != self.woct, "same address")
    self.pending_woct = addr
    self.pending_woct_epoch = epoch + 14400
    emit WoctChangeProposed(self.woct, addr, self.pending_woct_epoch)
    return true
  }

  fn accept_woct(): bool {
    require(caller == self.owner, "not authorized")
    require(self.pending_woct != "", "no pending change")
    require(epoch >= self.pending_woct_epoch, "timelock not elapsed")
    let old = self.woct
    self.woct = self.pending_woct
    self.pending_woct = ""
    self.pending_woct_epoch = 0
    emit WoctChanged(old, self.woct)
    return true
  }

  fn cancel_woct_change(): bool {
    require(caller == self.owner, "not authorized")
    self.pending_woct = ""
    self.pending_woct_epoch = 0
    return true
  }

  fn transfer_ownership(new_owner: address): bool {
    require(caller == self.owner, "not authorized")
    assert_address(new_owner)
    require(new_owner != "", "new owner is zero address")
    // [V7-CRIT-8] Two-step ownership transfer
    self.pending_owner = new_owner
    emit OwnershipTransferProposed(self.owner, new_owner)
    return true
  }

  fn accept_ownership(): bool {
    require(caller == self.pending_owner, "not pending owner")
    require(self.pending_owner != "", "no pending transfer")
    let old_owner = self.owner
    self.owner = self.pending_owner
    self.pending_owner = ""
    emit OwnershipTransferred(old_owner, self.owner)
    return true
  }

  // [AUDIT-FIX NEW-34] Emergency pause
  fn set_paused(status: bool): bool {
    require(caller == self.owner, "not authorized")
    self.paused = status
    emit Paused(status)
    return true
  }

  // [AUDIT-FIX NEW-35] Set max slippage (in bps)
  fn set_max_slippage_bps(bps: int): bool {
    require(caller == self.owner, "not authorized")
    // [S1-RT-02] Lower max to 1000 (10%) — high slippage exploitable in low-liquidity pools
    require(bps > 0 && bps <= 1000, "invalid slippage bps (max 10%)")
    let old_bps = self.max_slippage_bps
    self.max_slippage_bps = bps
    // [SECURITY] M-9: Emit event for transparency
    emit MaxSlippageBpsSet(old_bps, bps)
    return true
  }

  // [AUDIT-FIX CRIT-5] Router mengecek token_in terhadap token_a pool
  // dan memilih direction swap yang benar (swap_a_for_b atau swap_b_for_a)
  fn swap_exact_tokens_for_tokens(amount_in: int, min_out: int, token_in: address, token_out: address, to: address, deadline: int): int {
    require(!self.paused, "contract paused")
    require(amount_in > 0, "insufficient input")
    require(token_in != token_out, "same token")
    // [V7-CRIT-4] Enforce 5-minute deadline
    require(deadline > epoch && deadline <= epoch + 300, "deadline must be 1-300 seconds from now")
    assert_address(token_in)
    assert_address(token_out)
    // [AUDIT-FIX NEW-36] Validasi factory sudah dikonfigurasi
    require(self.factory != "" && self.factory != origin, "factory not configured")
    // [AUDIT-FIX NEW-37] Validasi min_out > 0 untuk mencegah sandwich attack tanpa proteksi
    require(min_out > 0, "min_out must be positive")
    // [AUDIT-FIX NEW-38] Validasi recipient tidak zero address
    require(to != "", "recipient is zero address")
    // [SECURITY] R-1: Reject token_in/token_out being the router itself
    require(token_in != self_addr && token_out != self_addr, "token cannot be router")

    let factory_addr = self.factory

    // Dapatkan pool address dari factory (bidirectional lookup)
    let pool_addr = call(factory_addr, "get_pool", [token_in, token_out])
    require(pool_addr != "", "no pool found")
    // [SECURITY] R-2/H-5: Reject recipient being the pool or factory to prevent stuck funds
    require(to != pool_addr, "recipient cannot be pool")
    require(to != factory_addr, "recipient cannot be factory")

    // [V7-CRIT-6] Validasi pool pair match requested tokens
    let pool_token_a = call(pool_addr, "get_token_a", [])
    let pool_token_b = call(pool_addr, "get_token_b", [])
    require((pool_token_a == token_in && pool_token_b == token_out) || (pool_token_a == token_out && pool_token_b == token_in), "pool tokens do not match requested pair")
    require(pool_token_a != pool_token_b, "pool tokens cannot be identical")

    // Tentukan arah swap berdasarkan token_a pool
    let is_a_to_b = (pool_token_a == token_in)

    // [V3-AUDIT-FIX] Enforce max_slippage_bps globally using expected output from the pool.
    // Querying get_amount_out from the pool gives the correct current exchange rate,
    // avoiding the broken 1:1 price assumption which blocked non-1:1 swaps (e.g. OES/WOCT).
    let expected_out = call(pool_addr, "get_amount_out", [amount_in, is_a_to_b])
    // [SECURITY] Reject malicious or broken pools that return 0 from get_amount_out
    // This prevents bypassing the global slippage check via zero output
    require(expected_out > 0, "pool returned zero output")
    let max_allowed_loss_bps = self.max_slippage_bps
    // [SECURITY] M-1: Use ceiling division to prevent rounding bypass. Without this,
    // a small `expected_out` (e.g., 1-99) would round `min_out_floor` to 0, silently
    // bypassing the global slippage check.
    let min_out_floor = (expected_out * (10000 - max_allowed_loss_bps) + 9999) / 10000
    // [SECURITY] Always enforce the floor when expected_out > 0
    if min_out_floor > 0 {
      require(min_out >= min_out_floor, "min_out below global max slippage threshold")
    }

    // [V2-HIGH-8] Record router's token_in balance before pull to detect malicious token contracts.
    let balance_before = call(token_in, "balance_of", [self_addr])

    // Pull token dari caller ke router
    require(call(token_in, "pull", [caller, self_addr, amount_in]), "token pull failed")

    // [V2-HIGH-8] Verify tokens were actually received by the router
    let balance_after = call(token_in, "balance_of", [self_addr])
    require(balance_after >= balance_before + amount_in, "token pull did not increase router balance (possible malicious token)")

    // [AUDIT-FIX MED-2] Grant the pool an allowance to pull token_in from the
    // router. The pool's swap_*_for_* does `token.pull(caller=router, pool, amount)`,
    // which requires grants[router][pool] >= amount_in. The multi-hop paths already
    // grant before each hop; single-hop omitted it, so every single-hop swap routed
    // through the Router reverted with "not allowed". Grant exactly amount_in — the
    // pool decrements the allowance back to 0 on pull, leaving no residual approval.
    require(call(token_in, "grant", [pool_addr, amount_in]), "token grant failed")

    // Pool's swap pulls from caller (Router). Router has tokens from step 1.
    // Pool sends output to caller (Router). Router forwards to recipient.
    let amount_out = 0
    if is_a_to_b {
      amount_out = call(pool_addr, "swap_a_for_b", [amount_in, min_out, deadline])
    } else {
      amount_out = call(pool_addr, "swap_b_for_a", [amount_in, min_out, deadline])
    }

    require(amount_out >= min_out, "insufficient output")
    require(amount_out > 0, "zero output")

    // Pool sent token_out to Router. Forward to recipient.
    require(to != self_addr, "recipient cannot be router")
    require(call(token_out, "transfer", [to, amount_out]), "output transfer failed")

    emit SwapExact(caller, token_in, token_out, amount_in, amount_out)
    return amount_out
  }

  // [MULTI-HOP] Swap through multiple pools: token_a → token_b → token_c
  // path1 = input token, path2 = intermediate token, path3 = output token
  fn swap_exact_tokens_for_tokens_path_3(amount_in: int, min_out: int, path1: address, path2: address, path3: address, to: address, deadline: int): int {
    require(!self.paused, "contract paused")
    require(amount_in > 0, "insufficient input")
    require(path1 != path2 && path2 != path3 && path1 != path3, "duplicate tokens in path")
    // [V7-CRIT-4] Enforce 5-minute deadline
    require(deadline > epoch && deadline <= epoch + 300, "deadline must be 1-300 seconds from now")
    assert_address(path1)
    assert_address(path2)
    assert_address(path3)
    assert_address(to)
    require(self.factory != "" && self.factory != origin, "factory not configured")
    require(min_out > 0, "min_out must be positive")
    require(to != "", "recipient is zero address")
    require(path1 != self_addr && path2 != self_addr && path3 != self_addr, "token cannot be router")

    // Pool 1: path1 → path2
    let pool1_addr = call(self.factory, "get_pool", [path1, path2])
    require(pool1_addr != "", "no pool for path1/path2")
    require(to != pool1_addr, "recipient cannot be pool1")

    let p1_token_a = call(pool1_addr, "get_token_a", [])
    let p1_token_b = call(pool1_addr, "get_token_b", [])
    let p1_is_a_to_b = (p1_token_a == path1)
    let expected1 = call(pool1_addr, "get_amount_out", [amount_in, p1_is_a_to_b])
    require(expected1 > 0, "pool1 returned zero output")

    // Pull input tokens
    let balance_before = call(path1, "balance_of", [self_addr])
    require(call(path1, "pull", [caller, self_addr, amount_in]), "token pull failed")
    let balance_after = call(path1, "balance_of", [self_addr])
    require(balance_after >= balance_before + amount_in, "token pull did not increase router balance")

    // Grant to pool1 and swap
    require(call(path1, "grant", [pool1_addr, amount_in]), "token grant failed")
    // [SECURITY] Apply slippage protection to intermediate hop using max_slippage_bps
    // This prevents sandwich attacks on intermediate pools. Without this, min_out=1
    // allows an attacker to front-run the first hop, manipulate the intermediate pool,
    // and profit from the second hop's unfavorable execution.
    let intermediate_min_out = 1
    if expected1 > 0 && self.max_slippage_bps < 10000 {
      intermediate_min_out = (expected1 * (10000 - self.max_slippage_bps) + 9999) / 10000
      if intermediate_min_out < 1 { intermediate_min_out = 1 }
    }
    let amount1_out = 0
    if p1_is_a_to_b {
      amount1_out = call(pool1_addr, "swap_a_for_b", [amount_in, intermediate_min_out, deadline])
    } else {
      amount1_out = call(pool1_addr, "swap_b_for_a", [amount_in, intermediate_min_out, deadline])
    }
    require(amount1_out > 0, "pool1 swap returned zero")

    // Pool 2: path2 → path3
    let pool2_addr = call(self.factory, "get_pool", [path2, path3])
    require(pool2_addr != "", "no pool for path2/path3")
    require(to != pool2_addr, "recipient cannot be pool2")
    require(to != pool1_addr, "recipient cannot be pool1")

    let p2_token_a = call(pool2_addr, "get_token_a", [])
    let p2_token_b = call(pool2_addr, "get_token_b", [])
    let p2_is_a_to_b = (p2_token_a == path2)

    // Grant pool2 to pull intermediate tokens from router
    require(call(path2, "grant", [pool2_addr, amount1_out]), "intermediate token grant failed")
    let amount2_out = 0
    if p2_is_a_to_b {
      amount2_out = call(pool2_addr, "swap_a_for_b", [amount1_out, min_out, deadline])
    } else {
      amount2_out = call(pool2_addr, "swap_b_for_a", [amount1_out, min_out, deadline])
    }

    require(amount2_out >= min_out, "insufficient output from multi-hop swap")

    // Transfer output to recipient
    require(to != self_addr, "recipient cannot be router")
    require(call(path3, "transfer", [to, amount2_out]), "output transfer failed")

    emit SwapExactPath(caller, 3, amount_in, amount2_out)
    return amount2_out
  }

  // [MULTI-HOP] Swap through 4 tokens (3 hops): A → B → C → D
  fn swap_exact_tokens_for_tokens_path_4(amount_in: int, min_out: int, path1: address, path2: address, path3: address, path4: address, to: address, deadline: int): int {
    require(!self.paused, "contract paused")
    require(amount_in > 0, "insufficient input")
    require(path1 != path2 && path1 != path3 && path1 != path4 && path2 != path3 && path2 != path4 && path3 != path4, "duplicate tokens in path")
    require(deadline > epoch && deadline <= epoch + 300, "deadline must be 1-300 seconds from now")
    assert_address(path1)
    assert_address(path2)
    assert_address(path3)
    assert_address(path4)
    assert_address(to)
    require(self.factory != "" && self.factory != origin, "factory not configured")
    require(min_out > 0, "min_out must be positive")
    require(to != "", "recipient is zero address")
    require(path1 != self_addr && path2 != self_addr && path3 != self_addr && path4 != self_addr, "token cannot be router")

    // Pool 1: path1 → path2
    let pool1_addr = call(self.factory, "get_pool", [path1, path2])
    require(pool1_addr != "", "no pool for path1/path2")
    let pool1_a = call(pool1_addr, "get_token_a", [])
    let pool1_b = call(pool1_addr, "get_token_b", [])
    let pool1_a2b = (pool1_a == path1)
    require(to != pool1_addr, "recipient cannot be pool1")

    let bal_before = call(path1, "balance_of", [self_addr])
    require(call(path1, "pull", [caller, self_addr, amount_in]), "token pull failed")
    require(call(path1, "balance_of", [self_addr]) >= bal_before + amount_in, "token pull did not increase router balance")
    require(call(path1, "grant", [pool1_addr, amount_in]), "token grant failed")
    // [SECURITY] Apply slippage protection to intermediate hop
    let intermediate_min_out_1 = 1
    let expected_out_1 = call(pool1_addr, "get_amount_out", [amount_in, pool1_a2b])
    if expected_out_1 > 0 && self.max_slippage_bps < 10000 {
      intermediate_min_out_1 = (expected_out_1 * (10000 - self.max_slippage_bps) + 9999) / 10000
      if intermediate_min_out_1 < 1 { intermediate_min_out_1 = 1 }
    }
    let amount_out_1 = 0
    if pool1_a2b {
      amount_out_1 = call(pool1_addr, "swap_a_for_b", [amount_in, intermediate_min_out_1, deadline])
    } else {
      amount_out_1 = call(pool1_addr, "swap_b_for_a", [amount_in, intermediate_min_out_1, deadline])
    }
    require(amount_out_1 > 0, "pool1 swap returned zero")

    // Pool 2: path2 → path3
    let pool2_addr = call(self.factory, "get_pool", [path2, path3])
    require(pool2_addr != "", "no pool for path2/path3")
    require(to != pool2_addr, "recipient cannot be pool2")
    let pool2_a = call(pool2_addr, "get_token_a", [])
    let pool2_b = call(pool2_addr, "get_token_b", [])
    let pool2_a2b = (pool2_a == path2)
    require(call(path2, "grant", [pool2_addr, amount_out_1]), "intermediate grant 1 failed")
    // [SECURITY] Apply slippage protection to second intermediate hop
    let intermediate_min_out_2 = 1
    let expected_out_2 = call(pool2_addr, "get_amount_out", [amount_out_1, pool2_a2b])
    if expected_out_2 > 0 && self.max_slippage_bps < 10000 {
      intermediate_min_out_2 = (expected_out_2 * (10000 - self.max_slippage_bps) + 9999) / 10000
      if intermediate_min_out_2 < 1 { intermediate_min_out_2 = 1 }
    }
    let amount_out_2 = 0
    if pool2_a2b {
      amount_out_2 = call(pool2_addr, "swap_a_for_b", [amount_out_1, intermediate_min_out_2, deadline])
    } else {
      amount_out_2 = call(pool2_addr, "swap_b_for_a", [amount_out_1, intermediate_min_out_2, deadline])
    }
    require(amount_out_2 > 0, "pool2 swap returned zero")

    // Pool 3: path3 → path4
    let pool3_addr = call(self.factory, "get_pool", [path3, path4])
    require(pool3_addr != "", "no pool for path3/path4")
    require(to != pool3_addr, "recipient cannot be pool3")
    let p3_a = call(pool3_addr, "get_token_a", [])
    let p3_b = call(pool3_addr, "get_token_b", [])
    let pool3_a2b = (p3_a == path3)
    require(call(path3, "grant", [pool3_addr, amount_out_2]), "intermediate grant 2 failed")
    let amount_out_3 = 0
    if pool3_a2b {
      amount_out_3 = call(pool3_addr, "swap_a_for_b", [amount_out_2, min_out, deadline])
    } else {
      amount_out_3 = call(pool3_addr, "swap_b_for_a", [amount_out_2, min_out, deadline])
    }

    require(amount_out_3 >= min_out, "insufficient output from multi-hop swap")
    require(to != self_addr, "recipient cannot be router")
    require(call(path4, "transfer", [to, amount_out_3]), "output transfer failed")

    emit SwapExactPath(caller, 4, amount_in, amount_out_3)
    return amount_out_3
  }

  // [MULTI-HOP] View function to estimate output amount for a 3-token path
  view fn get_amounts_out_path_3(amount_in: int, path1: address, path2: address, path3: address): int {
    // Pool 1: path1 → path2
    let pool1 = call(self.factory, "get_pool", [path1, path2])
    if pool1 == "" { return 0 }
    let pool1_a = call(pool1, "get_token_a", [])
    let pool1_b = call(pool1, "get_token_b", [])
    let pool1_a2b = (pool1_a == path1)
    let amount_out_1 = call(pool1, "get_amount_out", [amount_in, pool1_a2b])
    if amount_out_1 <= 0 { return 0 }

    // Pool 2: path2 → path3
    let pool2 = call(self.factory, "get_pool", [path2, path3])
    if pool2 == "" { return 0 }
    let pool2_a = call(pool2, "get_token_a", [])
    let pool2_b = call(pool2, "get_token_b", [])
    let pool2_a2b = (pool2_a == path2)
    let amount_out_2 = call(pool2, "get_amount_out", [amount_out_1, pool2_a2b])
    return amount_out_2
  }

  // [MULTI-HOP] View function to estimate output amount for a 4-token path
  view fn get_amounts_out_path_4(amount_in: int, path1: address, path2: address, path3: address, path4: address): int {
    let pool1 = call(self.factory, "get_pool", [path1, path2])
    if pool1 == "" { return 0 }
    let pool1_a2b = (call(pool1, "get_token_a", []) == path1)
    let amount_out_1 = call(pool1, "get_amount_out", [amount_in, pool1_a2b])
    if amount_out_1 <= 0 { return 0 }

    let pool2 = call(self.factory, "get_pool", [path2, path3])
    if pool2 == "" { return 0 }
    let pool2_a2b = (call(pool2, "get_token_a", []) == path2)
    let amount_out_2 = call(pool2, "get_amount_out", [amount_out_1, pool2_a2b])
    if amount_out_2 <= 0 { return 0 }

    let pool3 = call(self.factory, "get_pool", [path3, path4])
    if pool3 == "" { return 0 }
    let pool3_a2b = (call(pool3, "get_token_a", []) == path3)
    let amount_out_3 = call(pool3, "get_amount_out", [amount_out_2, pool3_a2b])
    return amount_out_3
  }

  // View to check if a path is valid (all pools exist)
  view fn is_path_valid_3(path1: address, path2: address, path3: address): bool {
    let pool1 = call(self.factory, "get_pool", [path1, path2])
    let pool2 = call(self.factory, "get_pool", [path2, path3])
    return pool1 != "" && pool2 != ""
  }

  view fn is_path_valid_4(path1: address, path2: address, path3: address, path4: address): bool {
    let pool1 = call(self.factory, "get_pool", [path1, path2])
    let pool2 = call(self.factory, "get_pool", [path2, path3])
    let pool3 = call(self.factory, "get_pool", [path3, path4])
    return pool1 != "" && pool2 != "" && pool3 != ""
  }

  view fn get_owner(): address {
    return self.owner
  }

  view fn get_factory(): address {
    return self.factory
  }

  view fn is_paused(): bool {
    return self.paused
  }

  view fn get_max_slippage_bps(): int {
    return self.max_slippage_bps
  }

  // [V7-CRIT-8] Two-step ownership views
  view fn get_pending_owner(): address {
    return self.pending_owner
  }
}
