contract SwapFactory {
  state {
    pools: list[address]
    pool_count: int
    // [V4-AUDIT-FIX] pools_by_pair maps token_a -> token_b -> pool_addr.
    // This supports multiple pools per token (e.g. WOCT/OES and WOCT/USDC), fixing
    // the critical routing limitation in v3.0 where pool_by_a restricted each token
    // to at most one pool globally.
    pools_by_pair: map[address]map[address]address
    pool_token_pair: map[address]address  // pool_addr -> token_a (metadata)
    pool_token_b_map: map[address]address // pool_addr -> token_b (metadata)
    fee_to: address
    fee_to_setter: address
    trusted_tokens: map[address]bool
    trusted_list: list[address]
    pending_setter: address
    pending_setter_epoch: int
    paused: bool
    trusted_removed: map[address]bool
    // [SECURITY] Track position of each trusted token in the list for O(1) swap-pop on remove
    // Value is 0-based index in trusted_list; absent (default 0) means not in list
    // (collision with legitimate index 0 is avoided by storing position+1)
    trusted_position: map[address]int
    // [ARCH] Equilibrium price guard config (V4-hook-inspired, adapted for AML)
    hub_token: address
    price_tolerance_bps: int
    // [V8] Token trust rating — LP-weighted community voting
    token_votes: map[address]int              // token -> total vote weight
    voter_has_voted: map[address]map[address]bool  // voter -> token -> voted
    voter_weight: map[address]map[address]int      // voter -> token -> vote weight used
    // [SECURITY] MEDIUM-8: Reentrancy guard for functions with external calls
    locked: bool
    // [V9] Reward Pool support
    pool_reward_token: map[address]address   // pool_addr → reward_token
    reward_pools: list[address]             // list of reward pools
    // [V11] Factory-first deployment: bytecode templates for atomically spawned
    // contracts (stored as base64 bytecode from octra_compileAml).
    pool_template: string
    token_template: string
    // [V11] Reference token for launch(): the wrapped-OCT side of new pools.
    woct_token: address
    // [V11] Spawn counter — mirrors the VM spawn nonce so counterfactual
    // addresses are predictable via octra_computeContractAddress(bytecode, factory, count).
    spawn_count: int
    // [V11] Reentrancy guard for create()/launch() (separate from `locked` used by vote_token)
    busy: bool
  }

  event PoolCreated(token_a: address, token_b: address, pool: address, pool_id: int)
  // [V11] Factory-first deployment events
  event PoolDeployed(token_a: address, token_b: address, pool: address)
  event TokenDeployed(token: address)
  event TemplateSet(kind: string)
  // [SECURITY] H-4: PoolRemoved event for indexer awareness on update_pool
  event PoolRemoved(token_a: address, token_b: address, old_pool: address, new_pool: address)
  event TrustedTokenAdded(token: address)
  event TrustedTokenRemoved(token: address)
  event SetterTransferInitiated(current: address, pending: address)
  event SetterTransferred(old_setter: address, new_setter: address)
  event Paused(status: bool)
  // [SECURITY] Event for fee_to changes
  event FeeToChanged(old_fee_to: address, new_fee_to: address)
  // [ARCH] Equilibrium guard events
  event HubTokenSet(old_hub: address, new_hub: address)
  event PriceToleranceSet(old_bps: int, new_bps: int)
  // [V8] Trust rating voting events
  event TokenVoted(token: address, voter: address, weight: int)
  event TokenUnvoted(token: address, voter: address, weight: int)

  constructor() {
    self.fee_to_setter = origin
    self.fee_to = origin
    self.pool_count = 0
    self.pending_setter = ""
    self.paused = false
    // [ARCH] Equilibrium guard defaults: no hub (disabled), 1% tolerance
    self.hub_token = ""
    self.price_tolerance_bps = 100
    // [SECURITY] MEDIUM-8: Initialize reentrancy guard
    self.locked = false
  }

  // ================= [V11] Factory-First Deployment =================

  // [V11] Admin-set bytecode templates (base64 from octra_compileAml). The
  // factory only spawns whitelisted code — create()/launch() take no bytecode.
  fn set_pool_template(code: string): bool {
    require(caller == self.fee_to_setter, "not authorized")
    require(code != "", "empty bytecode")
    self.pool_template = code
    emit TemplateSet("pool")
    return true
  }

  fn set_token_template(code: string): bool {
    require(caller == self.fee_to_setter, "not authorized")
    require(code != "", "empty bytecode")
    self.token_template = code
    emit TemplateSet("token")
    return true
  }

  // [V11] Reference token used as token_b in launch() pools.
  fn set_woct_token(addr: address): bool {
    require(caller == self.fee_to_setter, "not authorized")
    assert_address(addr)
    require(addr != "", "zero address")
    self.woct_token = addr
    return true
  }

  view fn get_spawn_count(): int {
    return self.spawn_count
  }

  view fn get_pool_template(): string {
    return self.pool_template
  }

  view fn get_token_template(): string {
    return self.token_template
  }

  view fn get_woct_token(): address {
    return self.woct_token
  }

  // [V11] Internal registration — same invariants as register_pool, called
  // after the factory itself spawned and configured the pool.
  fn _register_new_pool(token_a: address, token_b: address, pool: address): bool {
    // [V11-AUDIT] Confirm the spawned pool actually holds this token pair —
    // mirrors the public register_pool() H-3 fix so the same invariant holds
    // even when the factory itself registers a pool it just spawned.
    require(call(pool, "get_token_a", []) == token_a, "pool token_a mismatch")
    require(call(pool, "get_token_b", []) == token_b, "pool token_b mismatch")
    require(self.pools_by_pair[token_a][token_b] == "" || self.pools_by_pair[token_a][token_b] == "0", "pool already exists for this pair")
    require(self.pools_by_pair[token_b][token_a] == "" || self.pools_by_pair[token_b][token_a] == "0", "pool already exists for this pair")
    self.pools_by_pair[token_a][token_b] = pool
    self.pools_by_pair[token_b][token_a] = pool
    self.pool_token_pair[pool] = token_a
    self.pool_token_b_map[pool] = token_b
    self.pools.push(pool)
    let pool_id = self.pool_count
    self.pool_count = pool_id + 1
    emit PoolCreated(token_a, token_b, pool, pool_id)
    return true
  }

  // [V11] Atomic pool creation: spawn SwapPool, configure it, pull the user's
  // liquidity (user must pre-approve the factory via token.grant(factory, amt)),
  // mint the initial LP position to the caller, register the pair and propose
  // pool ownership to the caller (accepted via pool.accept_ownership()).
  fn create(token_a: address, token_b: address, fee_num: int, fee_den: int, max_ratio: int, liq_a: int, liq_b: int, min_lp: int, deadline: int, lock_duration: int): address {
    require(!self.paused, "factory paused")
    require(!self.busy, "reentrancy")
    require(self.pool_template != "", "pool template not set")
    require(token_a != token_b, "identical tokens")
    assert_address(token_a)
    assert_address(token_b)
    require(liq_a > 0 && liq_b > 0, "liquidity amounts must be positive")
    require(lock_duration >= 0 && lock_duration <= 525600, "invalid lock duration")
    require(deadline > epoch && deadline <= epoch + 300, "deadline must be 1-300 seconds from now")

    self.busy = true

    // Spawn + configure the pool (failures revert the whole tx). SwapPool
    // takes no constructor args, so deploy() is called with no args — passing
    // a `[]` literal would emit a one-element netstring the VM ignores anyway.
    let pool_addr = deploy(self.pool_template)
    self.spawn_count += 1
    require(call(pool_addr, "set_tokens", [token_a, token_b]), "set_tokens failed")
    require(call(pool_addr, "set_factory", [self_addr]), "set_factory failed")
    require(call(pool_addr, "set_fee_params", [fee_num, fee_den]), "set_fee_params failed")
    if max_ratio > 0 {
      require(call(pool_addr, "set_max_initial_price_ratio", [max_ratio]), "set_max_initial_price_ratio failed")
    }

    // Pull user liquidity into the factory, then pool pulls directly from factory
    // (add_liquidity_for pulls from caller, which is the factory in this case)
    require(call(token_a, "pull", [caller, self_addr, liq_a]), "token_a pull failed")
    require(call(token_b, "pull", [caller, self_addr, liq_b]), "token_b pull failed")

    // Initial position is minted directly to the caller
    call(pool_addr, "add_liquidity_for", [caller, liq_a, liq_b, min_lp, deadline, lock_duration])

    require(_register_new_pool(token_a, token_b, pool_addr), "register failed")
    emit PoolDeployed(token_a, token_b, pool_addr)

    // Two-step ownership transfer; caller completes with pool.accept_ownership()
    require(call(pool_addr, "transfer_ownership", [caller]), "transfer_ownership failed")

    self.busy = false
    return pool_addr
  }

  // [V11] Atomic token launch + pool creation. The factory spawns the token
  // (initial_owner = caller, supply_recipient = the factory so launch liquidity
  // is self-funded — no pre-approval needed on the new token), spawns the pool,
  // funds both sides, mints the LP position to the caller, transfers the
  // remaining supply to the caller and proposes pool ownership to the caller.
  // Note: tax and auto_burn must be disabled for factory-launched tokens (the
  // factory cannot set tax_exempt on a token it does not own).
  fn launch(n: string, s: string, contract_name: string, initial_supply: int, dec: int, initial_owner: address, supply_recipient: address, max_tx_amount: int, max_wallet_amount: int, cooldown_blocks: int, tax_bps: int, tax_recipient: address, auto_burn_bps: int, mintable: bool, burnable: bool, pausable: bool, blacklist: bool, max_tx: bool, max_wallet: bool, cooldown: bool, tax: bool, auto_burn: bool, trusted_1: address, trusted_2: address, trusted_3: address, trusted_4: address, trusted_5: address, fee_num: int, fee_den: int, max_ratio: int, liq_token: int, liq_woct: int, min_lp: int, deadline: int, lock_duration: int): (address, address) {
    require(!self.paused, "factory paused")
    require(!self.busy, "reentrancy")
    require(self.token_template != "" && self.pool_template != "", "templates not set")
    require(self.woct_token != "" && self.woct_token != "0", "woct token not set")
    require(liq_token > 0 && liq_woct > 0, "liquidity amounts must be positive")
    require(initial_supply >= liq_token, "liquidity exceeds supply")
    require(lock_duration >= 0 && lock_duration <= 525600, "invalid lock duration")
    require(deadline > epoch && deadline <= epoch + 300, "deadline must be 1-300 seconds from now")
    // [V11] The factory cannot exempt the pool from token tax/auto-burn on a
    // token it does not own — exact liquidity math requires both off.
    require(tax == false, "tax not supported on factory launch")
    require(auto_burn == false, "auto_burn not supported on factory launch")
    // [V11] Tax/auto_burn must be fully off (constructor requires the bps to
    // also be 0 so the flags can never be turned on afterwards).
    require(tax_bps == 0, "tax_bps must be 0 on factory launch")
    require(auto_burn_bps == 0, "auto_burn_bps must be 0 on factory launch")
    if max_tx {
      require(max_tx_amount >= liq_token, "max_tx lower than liquidity")
    }

    self.busy = true

    // [V11] The factory deploys the token itself: initial_owner is forced to
    // the caller (one less footgun) and supply_recipient is forced to the
    // factory so it funds the pool's token side without a separate grant.
    // The SPAWN2 call below reads contiguous param registers 0..26 — the
    // reassignments below MOV into reg 5 (initial_owner) and reg 6
    // (supply_recipient) in place, preserving contiguity.
    initial_owner = caller
    supply_recipient = self_addr

    // Spawn the token. NOTE: deploy() takes constructor args as VARIADIC params
    // (not [arr]) so SPAWN2 reads them straight from contiguous param registers
    // 0..26 — packing them into a netstring literal would overflow the 63-reg
    // local budget. Token params are in ordinate positions 0..26 = contiguous.
    let token_addr = deploy(self.token_template, n, s, contract_name, initial_supply, dec, initial_owner, supply_recipient, max_tx_amount, max_wallet_amount, cooldown_blocks, tax_bps, tax_recipient, auto_burn_bps, mintable, burnable, pausable, blacklist, max_tx, max_wallet, cooldown, tax, auto_burn, trusted_1, trusted_2, trusted_3, trusted_4, trusted_5)
    self.spawn_count += 1
    // The factory must hold the launch supply so it can fund the pool itself
    require(call(token_addr, "get_supply_recipient", []) == self_addr, "supply_recipient must be the factory")
    // [V11] Defense-in-depth: the pool spawns with set_tokens(token, woct) so
    // the two sides must be distinct. The factory's spawn counter guarantees
    // a different address, but asserting it explicitly keeps the invariant
    // visible at the call site.
    require(token_addr != self.woct_token, "token cannot equal woct")

    // Spawn + configure the pool (SwapPool takes no constructor args)
    let pool_addr = deploy(self.pool_template)
    self.spawn_count += 1
    require(call(pool_addr, "set_tokens", [token_addr, self.woct_token]), "set_tokens failed")
    require(call(pool_addr, "set_factory", [self_addr]), "set_factory failed")
    require(call(pool_addr, "set_fee_params", [fee_num, fee_den]), "set_fee_params failed")
    if max_ratio > 0 {
      require(call(pool_addr, "set_max_initial_price_ratio", [max_ratio]), "set_max_initial_price_ratio failed")
    }

    // Fund the pool: token side from factory's own supply (supply_recipient = factory),
    // WOCT side pulled from caller. add_liquidity_for pulls from caller (factory).
    require(call(self.woct_token, "pull", [caller, self_addr, liq_woct]), "woct pull failed")

    // Initial position is minted directly to the caller
    call(pool_addr, "add_liquidity_for", [caller, liq_token, liq_woct, min_lp, deadline, lock_duration])

    require(_register_new_pool(token_addr, self.woct_token, pool_addr), "register failed")
    emit PoolDeployed(token_addr, self.woct_token, pool_addr)
    emit TokenDeployed(token_addr)

    // Send the remaining supply to the caller
    let leftover = initial_supply - liq_token
    if leftover > 0 {
      require(call(token_addr, "transfer", [caller, leftover]), "leftover transfer failed")
    }

    // Two-step ownership transfer; caller completes with pool.accept_ownership()
    require(call(pool_addr, "transfer_ownership", [caller]), "transfer_ownership failed")

    self.busy = false
    return (token_addr, pool_addr)
  }

  // ================= [END V11] =================

  fn set_paused(status: bool): bool {
    require(caller == self.fee_to_setter, "not authorized")
    self.paused = status
    emit Paused(status)
    return true
  }

  // [V4-AUDIT-FIX] register_pool: Permissionless — anyone can deploy & register a pool.
  fn register_pool(token_a: address, token_b: address, pool: address): bool {
    require(!self.paused, "factory paused")
    require(token_a != token_b, "identical tokens")
    require(pool != "", "zero pool address")
    assert_address(token_a)
    assert_address(token_b)
    assert_address(pool)

    require(self.pool_token_pair[pool] == "" || self.pool_token_pair[pool] == "0", "pool already registered")

    // [AUDIT-FIX H-3] Verify the pool is a genuine initialized SwapPool for this
    // exact pair. Prevents an attacker from front-running a new pair registration
    // with an arbitrary/malicious address. View calls return the stored token; if
    // the pool is not a contract or holds different tokens, registration reverts.
    require(call(pool, "get_token_a", []) == token_a, "pool token_a mismatch")
    require(call(pool, "get_token_b", []) == token_b, "pool token_b mismatch")

    // Validate that no pool already exists for this specific token pair
    require(self.pools_by_pair[token_a][token_b] == "" || self.pools_by_pair[token_a][token_b] == "0", "pool already exists for this pair")
    require(self.pools_by_pair[token_b][token_a] == "" || self.pools_by_pair[token_b][token_a] == "0", "pool already exists for this pair")

    // Map the pool in both directions
    self.pools_by_pair[token_a][token_b] = pool
    self.pools_by_pair[token_b][token_a] = pool

    // Store both token_a and token_b for complete pool metadata
    self.pool_token_pair[pool] = token_a
    self.pool_token_b_map[pool] = token_b

    self.pools.push(pool)
    let pool_id = self.pool_count
    self.pool_count = pool_id + 1
    emit PoolCreated(token_a, token_b, pool, pool_id)
    return true
  }

  fn set_fee_to(_fee_to: address): bool {
    require(caller == self.fee_to_setter, "not authorized")
    assert_address(_fee_to)
    require(_fee_to != "", "zero address")
    let old_fee_to = self.fee_to
    self.fee_to = _fee_to
    // [SECURITY] Emit event for transparency
    emit FeeToChanged(old_fee_to, _fee_to)
    return true
  }

  fn initiate_setter_transfer(_setter: address): bool {
    require(caller == self.fee_to_setter, "not authorized")
    assert_address(_setter)
    require(_setter != "", "zero address")
    require(_setter != self.fee_to_setter, "same setter")
    self.pending_setter = _setter
    // [S1-SF-04] Add 24h timelock (14400 epochs)
    self.pending_setter_epoch = epoch + 14400
    emit SetterTransferInitiated(self.fee_to_setter, _setter)
    return true
  }

  fn accept_setter_transfer(): bool {
    require(caller == self.pending_setter, "not pending setter")
    require(self.pending_setter != "", "no pending transfer")
    // [S1-SF-04] Enforce 24h timelock
    require(epoch >= self.pending_setter_epoch, "timelock not elapsed")
    let old_setter = self.fee_to_setter
    self.fee_to_setter = self.pending_setter
    self.pending_setter = ""
    self.pending_setter_epoch = 0
    emit SetterTransferred(old_setter, self.fee_to_setter)
    return true
  }

  fn add_trusted_token(token: address): bool {
    require(caller == self.fee_to_setter, "not authorized")
    assert_address(token)
    // [SECURITY] H-3: Explicit zero-address check for clarity
    require(token != "", "zero token address")
    require(!self.trusted_tokens[token], "already trusted")
    // [S1-SF-03] Cap trusted list at 100 to prevent DoS
    require(len(self.trusted_list) < 100, "trusted list full (max 100)")
    self.trusted_tokens[token] = true
    self.trusted_removed[token] = false
    // [SECURITY] Only push to list if not already present (avoids duplicates)
    // trusted_position[token] == 0 means not in list (we store position+1)
    if self.trusted_position[token] == 0 {
      self.trusted_list.push(token)
      self.trusted_position[token] = len(self.trusted_list)
    }
    emit TrustedTokenAdded(token)
    return true
  }

  fn remove_trusted_token(token: address): bool {
    require(caller == self.fee_to_setter, "not authorized")
    assert_address(token)
    // [SECURITY] H-3: Explicit zero-address check for clarity
    require(token != "", "zero token address")
    require(self.trusted_tokens[token], "not trusted")
    self.trusted_tokens[token] = false
    self.trusted_removed[token] = true
    // [SECURITY] Remove from list using swap-pop to keep list consistent with is_trusted
    // The position is stored as (1-based) in trusted_position[token]
    let pos = self.trusted_position[token]
    if pos > 0 {
      // Convert to 0-based index
      let idx = pos - 1
      let last_idx = len(self.trusted_list) - 1
      if idx != last_idx {
        // Swap with last element
        let last_token = self.trusted_list[last_idx]
        self.trusted_list[idx] = last_token
        self.trusted_position[last_token] = idx + 1
      }
      // Pop the last element
      self.trusted_list.pop()
      self.trusted_position[token] = 0
    }
    emit TrustedTokenRemoved(token)
    return true
  }

  fn update_pool(token_a: address, token_b: address, pool: address): bool {
    require(!self.paused, "factory paused")
    require(caller == self.fee_to_setter, "not authorized")
    // [SECURITY] Full validation: zero addresses, identical tokens
    require(pool != "", "zero pool address")
    require(token_a != token_b, "identical tokens")
    assert_address(pool)
    assert_address(token_a)
    assert_address(token_b)
    require(self.pool_token_pair[pool] == "" || self.pool_token_pair[pool] == "0", "pool already registered")

    // [SECURITY] HIGH-1: Verify the new pool is a genuine initialized SwapPool for this
    // exact pair. Prevents fee_to_setter from replacing a pool with one that has different tokens.
    require(call(pool, "get_token_a", []) == token_a, "new pool token_a mismatch")
    require(call(pool, "get_token_b", []) == token_b, "new pool token_b mismatch")

    let old_pool = self.pools_by_pair[token_a][token_b]
    if old_pool == "" || old_pool == "0" {
      old_pool = self.pools_by_pair[token_b][token_a]
    }
    require(old_pool != "" && old_pool != "0", "no existing pool for pair")
    require(pool != old_pool, "pool unchanged")

    self.pools_by_pair[token_a][token_b] = pool
    self.pools_by_pair[token_b][token_a] = pool
    self.pool_token_pair[pool] = token_a
    self.pool_token_b_map[pool] = token_b
    // [SECURITY] Clear old pool metadata to avoid state inconsistency
    self.pool_token_pair[old_pool] = ""
    self.pool_token_b_map[old_pool] = ""
    // [SECURITY] M-3: Remove old pool from the `pools` list to avoid stale entries
    // in `all_pools()`. Iterate the list, find the old pool, swap-pop it.
    let i = 0
    let found = false
    while i < len(self.pools) {
      if self.pools[i] == old_pool {
        let last_idx = len(self.pools) - 1
        if i != last_idx {
          let last_pool = self.pools[last_idx]
          self.pools[i] = last_pool
        }
        self.pools.pop()
        found = true
      }
      i += 1
    }
    // Decrement pool_count since we removed one
    if found {
      self.pool_count = self.pool_count - 1
    }
    self.pools.push(pool)
    let pool_id = self.pool_count
    self.pool_count = pool_id + 1
    // [SECURITY] H-4: Emit PoolRemoved event for the old pool (so indexers can track
    // pool replacements) followed by PoolCreated for the new one.
    emit PoolRemoved(token_a, token_b, old_pool, pool)
    emit PoolCreated(token_a, token_b, pool, pool_id)
    return true
  }

  // [V10] remove_pool: Allows the pool creator (owner) to deregister a pool from the factory.
  // Safety requirements:
  //   1. Caller must be the pool's owner (creator). Only fee_to_setter can bypass (emergency).
  //   2. Pool must have zero reserves (fully drained) to protect LPs.
  //   3. Pool must have zero total_lp (no active liquidity positions).
  // This prevents rug-pulls: a creator cannot remove a pool that still has user funds.
  // After removal the factory no longer routes to this pool; the pool contract itself persists.
  event PoolDeregistered(token_a: address, token_b: address, pool: address, removed_by: address)

  fn remove_pool(pool: address): bool {
    require(!self.paused, "factory paused")
    require(pool != "", "zero pool address")
    assert_address(pool)

    // Verify pool is actually registered
    let token_a = self.pool_token_pair[pool]
    require(token_a != "" && token_a != "0", "pool not registered")
    let token_b = self.pool_token_b_map[pool]

    // Auth: caller must be pool owner (creator) OR the factory fee_to_setter
    let pool_owner = call(pool, "owner", [])
    let is_authorized = (caller == pool_owner || caller == self.fee_to_setter)
    require(is_authorized, "not pool owner or admin")

    // Safety: pool must be fully drained (no reserves)
    // This prevents a creator from removing a pool that still has LP funds
    let reserve_a = call(pool, "reserve_a", [])
    let reserve_b = call(pool, "reserve_b", [])
    require(reserve_a == 0 || reserve_a == "0", "pool still has token_a reserves")
    require(reserve_b == 0 || reserve_b == "0", "pool still has token_b reserves")

    // Safety: no active LP positions
    let total_lp = call(pool, "total_lp", [])
    require(total_lp == 0 || total_lp == "0", "pool still has active LP positions")

    // Remove from pools_by_pair map (both directions)
    self.pools_by_pair[token_a][token_b] = ""
    self.pools_by_pair[token_b][token_a] = ""

    // Clear pool metadata
    self.pool_token_pair[pool] = ""
    self.pool_token_b_map[pool] = ""

    // Clear reward pool metadata if applicable
    if self.pool_reward_token[pool] != "" && self.pool_reward_token[pool] != "0" {
      self.pool_reward_token[pool] = ""
    }

    // Remove from pools list using swap-pop (O(1) removal)
    // [V11-FIX] AML has no `break` — use a found-flag loop instead.
    let i = 0
    let found_pool = false
    while i < len(self.pools) && !found_pool {
      if self.pools[i] == pool {
        let last_idx = len(self.pools) - 1
        if i != last_idx {
          let last_pool = self.pools[last_idx]
          self.pools[i] = last_pool
        }
        self.pools.pop()
        self.pool_count = self.pool_count - 1
        found_pool = true
      }
      i += 1
    }

    // Remove from reward_pools list if present
    let j = 0
    let found_reward = false
    while j < len(self.reward_pools) && !found_reward {
      if self.reward_pools[j] == pool {
        let last_idx_r = len(self.reward_pools) - 1
        if j != last_idx_r {
          let last_rpool = self.reward_pools[last_idx_r]
          self.reward_pools[j] = last_rpool
        }
        self.reward_pools.pop()
        found_reward = true
      }
      j += 1
    }

    emit PoolDeregistered(token_a, token_b, pool, caller)
    return true
  }

  view fn get_pool(token_a: address, token_b: address): address {
    let pool = self.pools_by_pair[token_a][token_b]
    if pool != "" && pool != "0" {
      return pool

    }
    let pool2 = self.pools_by_pair[token_b][token_a]
    if pool2 != "" && pool2 != "0" {
      return pool2
    }
    return ""
  }

  view fn get_pool_token_a(pool: address): address {
    return self.pool_token_pair[pool]
  }

  view fn get_pool_token_b(pool: address): address {
    return self.pool_token_b_map[pool]
  }

  view fn all_pools(): list[address] {
    return self.pools
  }

  view fn pools_length(): int {
    return self.pool_count
  }

  view fn is_trusted(token: address): bool {
    return self.trusted_tokens[token]
  }

  // [V4-AUDIT-FIX] Simplified get_trusted_tokens to return the full list and avoid
  // local .push which is unsupported by the AML compiler. Filtering is handled off-chain.
  view fn get_trusted_tokens(): list[address] {
    return self.trusted_list
  }

  // [V4-AUDIT-FIX] Simplified trusted_tokens_count
  view fn trusted_tokens_count(): int {
    return len(self.trusted_list)
  }

  view fn get_fee_to(): address {
    return self.fee_to
  }

  view fn get_pending_setter(): address {
    return self.pending_setter
  }

  view fn get_fee_to_setter(): address {
    return self.fee_to_setter
  }

  // [ARCH] Equilibrium price guard — admin config

  fn set_hub_token(token: address): bool {
    require(caller == self.fee_to_setter, "not authorized")
    assert_address(token)
    let old = self.hub_token
    self.hub_token = token
    emit HubTokenSet(old, token)
    return true
  }

  fn set_price_tolerance_bps(bps: int): bool {
    require(caller == self.fee_to_setter, "not authorized")
    require(bps > 0 && bps <= 500, "tolerance must be 1-500 bps (0.01%-5%)")
    let old = self.price_tolerance_bps
    self.price_tolerance_bps = bps
    emit PriceToleranceSet(old, bps)
    return true
  }

  // [ARCH] validate_initial_price — called by SwapPool during first add_liquidity.
  // Derives the equilibrium price of token_a in token_b via the hub token path
  // (token_a → hub → token_b) using existing pools' get_price() (single-int return).
  // Returns true (allow) if: hub not configured, direct hub pair, no hub path,
  // or computation overflows int64 (extreme ratios). Only enforces when all math
  // fits safely — overflow-safe fallback prevents DoS.
  fn validate_initial_price(token_a: address, token_b: address, amount_a: int, amount_b: int): bool {
    let hub = self.hub_token
    if hub == "" || hub == "0" {
      return true
    }
    if token_a == hub || token_b == hub {
      return true
    }
    if amount_a <= 0 || amount_b <= 0 {
      return true
    }

    let pool_ah = self.pools_by_pair[token_a][hub]
    if pool_ah == "" || pool_ah == "0" {
      pool_ah = self.pools_by_pair[hub][token_a]
    }
    let pool_hb = self.pools_by_pair[hub][token_b]
    if pool_hb == "" || pool_hb == "0" {
      pool_hb = self.pools_by_pair[token_b][hub]
    }
    if pool_ah == "" || pool_ah == "0" || pool_hb == "" || pool_hb == "0" {
      return true
    }

    let ah_price = call(pool_ah, "get_price", [])
    let hb_price = call(pool_hb, "get_price", [])
    if ah_price <= 0 || hb_price <= 0 {
      return true
    }

    let ah_ta = call(pool_ah, "get_token_a", [])
    let hb_ta = call(pool_hb, "get_token_a", [])

    // price_a_in_hub: how much hub per 1 token_a, scaled by 10^6
    let price_a_in_hub = ah_price
    if ah_ta != token_a {
      if ah_price < 1000000 {
        return true
      }
      price_a_in_hub = 1000000000000 / ah_price
    }

    // price_hub_in_b: how much token_b per 1 hub, scaled by 10^6
    let price_hub_in_b = hb_price
    if hb_ta != hub {
      if hb_price < 1000000 {
        return true
      }
      price_hub_in_b = 1000000000000 / hb_price
    }

    // eq_price = price_a_in_hub * price_hub_in_b / 10^6 (scaled by 10^6)
    let prod = price_a_in_hub * price_hub_in_b
    if price_a_in_hub > 0 && prod / price_a_in_hub != price_hub_in_b {
      return true
    }
    let eq_price = prod / 1000000
    if eq_price <= 0 {
      return true
    }

    // user_price = amount_b * 10^6 / amount_a (scaled by 10^6)
    let amt_b_scaled = amount_b * 1000000
    if amount_b > 0 && amt_b_scaled / amount_b != 1000000 {
      return true
    }
    let user_price = amt_b_scaled / amount_a
    if user_price <= 0 {
      return true
    }

    // Tolerance: |user_price - eq_price| / eq_price <= tolerance_bps / 10000
    let diff = 0
    if user_price > eq_price {
      diff = user_price - eq_price
    } else {
      diff = eq_price - user_price
    }

    let lhs = diff * 10000
    if diff > 0 && lhs / diff != 10000 {
      return true
    }
    let rhs = eq_price * self.price_tolerance_bps
    if eq_price > 0 && rhs / eq_price != self.price_tolerance_bps {
      return true
    }

    require(lhs <= rhs, "initial price misaligned with equilibrium")
    return true
  }

  // [V9] register_reward_pool: Permissionless — anyone can deploy & register a reward pool.
  fn register_reward_pool(token_a: address, token_b: address, reward_token: address, pool: address): bool {
    require(!self.paused, "factory paused")
    require(token_a != token_b, "identical tokens")
    require(reward_token != token_a && reward_token != token_b, "reward token is pair token")
    require(pool != "", "zero pool address")
    assert_address(token_a)
    assert_address(token_b)
    assert_address(reward_token)

    require(self.pool_token_pair[pool] == "" || self.pool_token_pair[pool] == "0", "pool already registered")

    // Verify pool is a genuine SwapPool/RewardPool for this pair
    require(call(pool, "get_token_a", []) == token_a, "pool token_a mismatch")
    require(call(pool, "get_token_b", []) == token_b, "pool token_b mismatch")

    // Validate no existing pool for this pair
    require(self.pools_by_pair[token_a][token_b] == "" || self.pools_by_pair[token_a][token_b] == "0", "pool already exists for this pair")
    require(self.pools_by_pair[token_b][token_a] == "" || self.pools_by_pair[token_b][token_a] == "0", "pool already exists for this pair")

    // Map pool in both directions
    self.pools_by_pair[token_a][token_b] = pool
    self.pools_by_pair[token_b][token_a] = pool

    self.pool_token_pair[pool] = token_a
    self.pool_token_b_map[pool] = token_b
    self.pool_reward_token[pool] = reward_token

    self.pools.push(pool)
    self.reward_pools.push(pool)
    let pool_id = self.pool_count
    self.pool_count = pool_id + 1
    emit PoolCreated(token_a, token_b, pool, pool_id)
    return true
  }

  // [V9] Reward pool views
  view fn get_reward_token(pool: address): address {
    return self.pool_reward_token[pool]
  }

  view fn get_reward_pools(): list[address] {
    return self.reward_pools
  }

  view fn is_reward_pool(pool: address): bool {
    let token = self.pool_reward_token[pool]
    if token != "" && token != "0" {
      return true
    }
    return false
  }

  // [V8] Trust rating — LP-weighted community voting
  // Vote weight = min(voter's locked LP, 5% of total locked LP) in the token's pool.
  // Requires the token to have a pool with the hub token (WOCT).
  fn vote_token(token: address): bool {
    require(!self.paused, "factory paused")
    assert_address(token)
    require(token != "", "zero token address")
    require(token != self.hub_token, "cannot vote on hub token")
    // [SECURITY] MEDIUM-8: Add reentrancy guard for external calls
    require(!self.locked, "reentrancy guard")
    self.locked = true

    // Find pool for token/hub pair
    let pool = self.pools_by_pair[token][self.hub_token]
    if pool == "" || pool == "0" {
      pool = self.pools_by_pair[self.hub_token][token]
    }
    require(pool != "" && pool != "0", "no pool for token")

    // Get voter's locked LP in this pool
    let locked_lp = call(pool, "get_locked_liquidity", [caller])
    require(locked_lp > 0, "no locked LP")

    // Cap at 5% of total locked LP
    let total_locked = call(pool, "get_total_locked_lp", [])
    let max_vote = total_locked / 20
    let vote_weight = locked_lp
    if vote_weight > max_vote {
      vote_weight = max_vote
    }
    require(vote_weight > 0, "vote weight too small")

    // Deduct previous vote if exists
    if self.voter_has_voted[caller][token] {
      let prev_weight = self.voter_weight[caller][token]
      self.token_votes[token] = self.token_votes[token] - prev_weight
    }

    self.voter_has_voted[caller][token] = true
    self.voter_weight[caller][token] = vote_weight
    self.token_votes[token] = self.token_votes[token] + vote_weight
    self.locked = false
    emit TokenVoted(token, caller, vote_weight)
    return true
  }

  fn unvote_token(token: address): bool {
    assert_address(token)
    require(self.voter_has_voted[caller][token], "not voted")
    let prev_weight = self.voter_weight[caller][token]
    self.voter_has_voted[caller][token] = false
    self.voter_weight[caller][token] = 0
    self.token_votes[token] = self.token_votes[token] - prev_weight
    emit TokenUnvoted(token, caller, prev_weight)
    return true
  }

  view fn get_token_votes(token: address): int {
    return self.token_votes[token]
  }

  view fn has_voted(voter: address, token: address): bool {
    return self.voter_has_voted[voter][token]
  }
}
