// EverestSwap concentrated-liquidity pool.
//
// Liquidity is supplied over a bounded price range rather than across the whole
// curve, so each provider chooses the ticks between which their capital is
// active. Price is tracked as a Q64.96 square root; the active range boundaries
// are indexed by a bitmap so a swap can find the next boundary it will cross
// without scanning.
//
// Three VM facts shape the whole file:
//   * integers are arbitrary precision, so there is no overflow to guard and
//     no wraparound trick available for signed fee accounting;
//   * `/` and `%` truncate toward zero, so anything indexing a signed tick
//     uses floor_div/floor_mod from the math include;
//   * `for` executes a single iteration, so every loop here is a `while`, and
//     helpers are never recursive.
//
// One VM fact shapes the signatures: a boolean handed to another contract
// arrives as `true` whatever it was, because the argument is carried as text and
// any text reads as true. So a trade direction crosses a boundary as `dir`, an
// int, where 1 sells token0 for token1 and 0 sells token1 for token0. Booleans
// are still safe inside the contract and are used freely there.
//
// Payment is pull-based: the pool moves tokens itself via the token's `pull`,
// charging whoever called it. There is no callback into the payer, so a swap
// cannot re-enter through the settlement path. `caller` is always the payer;
// note that `origin` is an alias for `caller` on this VM and must never be
// used to identify an end user behind a router hop.

contract EverestPool {
  state {
    // ── configuration, written once by whoever deployed the pool ──
    deployer: address
    factory: address
    token0: address
    token1: address
    fee_pips: int            // fee in hundredths of a bip; 3000 = 0.30%
    spacing: int
    max_liq_per_tick: int
    configured: bool

    // ── current price and range ──
    sqrt_price_x96: int
    cur_tick: int
    liq: int                 // liquidity active at the current price
    liq_total: int           // total outstanding position liquidity, mint - burn;
                             // unlike `liq` this counts positions out of range too
    started: bool
    // Set to 1 by a public entry point around a run of internal helpers and
    // cleared straight after — never held across a call() to another contract.
    // AML has no function visibility, so every helper is externally callable;
    // this flag is how a helper tells a legitimate internal call from a direct
    // one. `caller` is unchanged across an internal jump, so it cannot.
    gate: int

    // ── fee accounting ──
    fee_proto_0: int         // protocol takes 1/n of the swap fee; 0 = off
    fee_proto_1: int
    fg0: int                 // fee growth per unit liquidity, Q128
    fg1: int
    proto_owed_0: int
    proto_owed_1: int

    // ── per-tick state (parallel maps: the VM has no struct type) ──
    t_gross: map[int]int     // total liquidity referencing this tick
    t_net: map[int]int       // liquidity added when crossing left-to-right
    t_fg0_out: map[int]int   // fee growth on the far side of this tick
    t_fg1_out: map[int]int
    t_cum_out: map[int]int
    t_spl_out: map[int]int
    t_secs_out: map[int]int
    t_init: map[int]bool
    tick_bitmap: map[int]int // required by the bitmap include

    // ── positions, keyed owner -> lower -> upper ──
    p_liq: map[address]map[int]map[int]int
    p_fg0: map[address]map[int]map[int]int
    p_fg1: map[address]map[int]map[int]int
    p_owed0: map[address]map[int]map[int]int
    p_owed1: map[address]map[int]map[int]int

    // ── price oracle ring buffer ──
    o_ts: map[int]int
    o_tcum: map[int]int
    o_spl: map[int]int
    o_init: map[int]bool
    o_index: int
    o_card: int
    o_card_next: int
  }

  event Initialize(sqrt_price_x96: int, tick: int)
  event Mint(owner: address, payer: address, tick_lower: int, tick_upper: int, amount: int, amount0: int, amount1: int)
  event Burn(owner: address, recipient: address, tick_lower: int, tick_upper: int, amount: int, amount0: int, amount1: int)
  event Collect(owner: address, recipient: address, tick_lower: int, tick_upper: int, amount0: int, amount1: int)
  event Swap(sender: address, recipient: address, amount0: int, amount1: int, sqrt_price_x96: int, liquidity: int, tick: int)
  event Flash(sender: address, recipient: address, amount0: int, amount1: int, paid0: int, paid1: int)
  event Configured(token0: address, token1: address, fee_pips: int, spacing: int)
  event SetFeeProtocol(old0: int, old1: int, new0: int, new1: int)
  event CollectProtocol(recipient: address, amount0: int, amount1: int)
  event ObservationCardinalityIncreased(old_next: int, new_next: int)

  constructor() {
    // `caller` in a constructor reached through deploy() is the deploying
    // contract, which is how the factory claims the right to configure.
    self.deployer = caller
    self.factory = caller
    self.configured = false
    self.started = false
    self.liq = 0
    self.liq_total = 0
    self.gate = 0
    self.fg0 = 0
    self.fg1 = 0
    self.fee_proto_0 = 0
    self.fee_proto_1 = 0
    self.proto_owed_0 = 0
    self.proto_owed_1 = 0
    self.o_index = 0
    self.o_card = 0
    self.o_card_next = 0
  }

  // ===== begin lib/math.aml.inc (generated — edit contracts/lib/math.aml.inc) =====
  // ---------------------------------------------------------------------------
  // Integer helpers
  //
  // Two facts about this VM shape everything below:
  //   * `int` is arbitrary precision, so a 256-bit-wide intermediate needs no
  //     multi-limb emulation and mul_div is literally `a * b / d`.
  //   * `/` and `%` truncate toward zero rather than flooring, so anything that
  //     indexes on a signed tick has to spell floor semantics out. Bare `/` there
  //     is an off-by-one for every price below 1.0.
  // There are no bitwise operators, so bit work goes through pow/`/`/`%`.
  // ---------------------------------------------------------------------------

  view fn floor_mod(a: int, b: int): int {
    require(b != 0, "mod by zero")
    let m = a % b
    if m < 0 {
      m = m + b
    }
    return m
  }

  view fn floor_div(a: int, b: int): int {
    require(b != 0, "div by zero")
    let q = a / b
    if a % b != 0 {
      if a < 0 {
        if b > 0 {
          q = q - 1
        }
      }
      if a > 0 {
        if b < 0 {
          q = q - 1
        }
      }
    }
    return q
  }

  view fn mul_div(a: int, b: int, d: int): int {
    require(d != 0, "div by zero")
    return a * b / d
  }

  view fn mul_div_up(a: int, b: int, d: int): int {
    require(d != 0, "div by zero")
    let p = a * b
    let q = p / d
    if p % d != 0 {
      q = q + 1
    }
    return q
  }

  view fn div_up(a: int, b: int): int {
    require(b != 0, "div by zero")
    let q = a / b
    if a % b != 0 {
      q = q + 1
    }
    return q
  }

  // Index of the most significant set bit, by unrolled binary search. Stands in
  // for the shift-and-compare scan the reference log2 routine uses.
  view fn msb(x: int): int {
    require(x > 0, "msb of zero")
    let r = 0
    let v = x
    if v >= 340282366920938463463374607431768211456 {
      v = v / 340282366920938463463374607431768211456
      r = r + 128
    }
    if v >= 18446744073709551616 {
      v = v / 18446744073709551616
      r = r + 64
    }
    if v >= 4294967296 {
      v = v / 4294967296
      r = r + 32
    }
    if v >= 65536 {
      v = v / 65536
      r = r + 16
    }
    if v >= 256 {
      v = v / 256
      r = r + 8
    }
    if v >= 16 {
      v = v / 16
      r = r + 4
    }
    if v >= 4 {
      v = v / 4
      r = r + 2
    }
    if v >= 2 {
      r = r + 1
    }
    return r
  }

  // Index of the least significant set bit. `x & -x` is unavailable, so this
  // binary-searches on "are the low k bits all zero" via modulo.
  view fn lsb(x: int): int {
    require(x > 0, "lsb of zero")
    let r = 0
    let v = x
    if v % 340282366920938463463374607431768211456 == 0 {
      v = v / 340282366920938463463374607431768211456
      r = r + 128
    }
    if v % 18446744073709551616 == 0 {
      v = v / 18446744073709551616
      r = r + 64
    }
    if v % 4294967296 == 0 {
      v = v / 4294967296
      r = r + 32
    }
    if v % 65536 == 0 {
      v = v / 65536
      r = r + 16
    }
    if v % 256 == 0 {
      v = v / 256
      r = r + 8
    }
    if v % 16 == 0 {
      v = v / 16
      r = r + 4
    }
    if v % 4 == 0 {
      v = v / 4
      r = r + 2
    }
    if v % 2 == 0 {
      r = r + 1
    }
    return r
  }

  // 2^128 — the fixed-point denominator for every fee-growth accumulator.
  // Written as a literal because `pow(2, 128)` re-derives it on every call and
  // fee growth is touched on each tick crossing.
  view fn q128(): int {
    return 340282366920938463463374607431768211456
  }

  // The largest value a 128-bit liquidity figure can hold. Liquidity is
  // arbitrary-precision here, so this is a policy cap rather than a hardware
  // one: it keeps per-tick liquidity inside the range the price/amount math was
  // validated over.
  view fn liquidity_max(): int {
    return 340282366920938463463374607431768211455
  }
  // ===== end lib/math.aml.inc =====

  // ===== begin lib/tickmath.aml.inc (generated — edit contracts/lib/tickmath.aml.inc) =====
  // ---------------------------------------------------------------------------
  // Tick <-> sqrt-price conversion, Q64.96.
  //
  //   sqrt_price_x96 = sqrt(1.0001 ^ tick) * 2^96
  //
  // Ports the canonical multiply-and-shift ladder: each of the 20 stages folds in
  // one bit of |tick|, with `>> 128` written as division by 2^128. Verified
  // bit-exact against the reference implementation at 289 ticks spanning the whole
  // usable range, including every power-of-two boundary and both extremes.
  // ---------------------------------------------------------------------------

  view fn min_tick(): int {
    return -887272
  }

  view fn max_tick(): int {
    return 887272
  }

  view fn min_sqrt_ratio(): int {
    return 4295128739
  }

  view fn max_sqrt_ratio(): int {
    return 1461446703485210103287273052203988822378723970342
  }

  // One stage of the ladder: (r * c) >> 128.
  view fn ratio_stage(r: int, c: int): int {
    return r * c / 340282366920938463463374607431768211456
